---
import { hebStores as hebStoreData } from "../data/hebGeoData";

const stationCount = hebStoreData.length;
---

<section
  class="heb-landing"
  aria-labelledby="heb-shinkansen-title"
  data-map-root
  data-view-state="landing"
  data-regional-view="false"
>
  <div
    class="heb-landing__scene"
    data-map-scene
    aria-label="Interactive geolocated Texas H-E-B Shinkansen map"
  >
  </div>

  <div class="heb-landing__hud" data-ui-hud>
    <nav class="heb-landing__nav" aria-label="Primary">
      <a href="#home">Home</a>
      <a href="#regions">Regions</a>
      <a href="#cities">Cities</a>
      <a href="#about">About</a>
    </nav>

    <div class="heb-landing__intro" data-map-trigger>
      <div
        class="heb-landing__copy"
        data-intro-copy
        role="button"
        tabindex="0"
        aria-label={`Reveal statewide H-E-B station network with ${stationCount} Texas stations`}
      >
        <p class="heb-landing__eyebrow">Texas State Guide</p>
        <h1 id="heb-shinkansen-title">HEB Shinkansen</h1>
        <p class="heb-landing__subtitle">Choose your Stations</p>
      </div>
    </div>

    <div class="heb-landing__actions" aria-label="Map actions">
      <a class="heb-landing__button heb-landing__button--primary" href="#start"
        >GET STARTED</a
      >
      <a
        class="heb-landing__button heb-landing__button--secondary"
        href="#details">SEE DETAILS</a
      >
    </div>

    <div class="heb-landing__region-hud" data-region-hud hidden>
      <div class="heb-landing__region-title" data-region-title-panel>
        <p class="heb-landing__region-kicker">Regional View</p>
        <h2 data-region-title>SOUTH TEXAS REGIONAL NETWORK</h2>
      </div>
      <button
        class="heb-landing__region-return"
        type="button"
        data-region-return>Return to State View</button
      >
    </div>

    <aside
      class="heb-landing__selection-panel"
      data-selection-panel
      aria-label="Selected H-E-B stations"
      hidden
    >
      <header class="heb-landing__selection-panel-header">
        <p class="heb-landing__selection-panel-kicker">Your Traversal</p>
        <h3 class="heb-landing__selection-panel-title">Routes</h3>
        <p
          class="heb-landing__selection-panel-count"
          data-selection-count
          aria-live="polite">0 stations</p
        >
      </header>
      <div
        class="heb-landing__route-accordion"
        data-route-accordion
        role="list"
      >
      </div>
    </aside>
  </div>
</section>

<script>
  import { animate, createTimeline } from "animejs";
  import maplibregl, {
    type Map as MapLibreMap,
    type MapLayerMouseEvent,
  } from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import * as THREE from "three";
  import { DRACOLoader } from "three/examples/jsm/loaders/DRACOLoader.js";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
  import { hebStores, texasPath } from "../data/hebGeoData";

  const root = document.querySelector<HTMLElement>("[data-map-root]");
  const mapHost = root?.querySelector<HTMLElement>("[data-map-scene]");
  const introCopy = root?.querySelector<HTMLElement>("[data-intro-copy]");
  const regionHud = root?.querySelector<HTMLElement>("[data-region-hud]");
  const regionTitlePanel = root?.querySelector<HTMLElement>(
    "[data-region-title-panel]",
  );
  const regionTitle = root?.querySelector<HTMLElement>("[data-region-title]");
  const regionReturn = root?.querySelector<HTMLButtonElement>(
    "[data-region-return]",
  );
  const selectionPanel = root?.querySelector<HTMLElement>(
    "[data-selection-panel]",
  );
  const accordionContainer = root?.querySelector<HTMLElement>(
    "[data-route-accordion]",
  );
  const selectionCount = root?.querySelector<HTMLElement>(
    "[data-selection-count]",
  );

  if (
    root &&
    mapHost &&
    introCopy &&
    regionHud &&
    regionTitlePanel &&
    regionTitle &&
    regionReturn &&
    selectionPanel &&
    accordionContainer &&
    selectionCount
  ) {
    type SvgPoint = { x: number; y: number };
    type SvgBounds = { minX: number; maxX: number; minY: number; maxY: number };
    type GeoJsonPosition = [number, number];
    type GlobalMercatorFrame = {
      svgBounds: SvgBounds;
      projectedMin: { x: number; y: number };
      projectedMax: { x: number; y: number };
    };
    type TexasRegionSpec = {
      id: string;
      name: string;
      clips: SvgPoint[][];
    };
    type RegionDefinition = {
      id: string;
      name: string;
      svgPolygons: SvgPoint[][];
      coordinates: GeoJsonPosition[][][];
      bounds: maplibregl.LngLatBounds;
    };
    type StoreDefinition = (typeof hebStores)[number] & {
      regionId: string;
      regionName: string;
    };
    type MapGeometry =
      | { type: "Polygon"; coordinates: GeoJsonPosition[][] }
      | { type: "LineString"; coordinates: GeoJsonPosition[] };
    type MapFeature = {
      type: "Feature";
      id?: string;
      properties: Record<string, unknown>;
      geometry: MapGeometry;
    };
    type MapFeatureCollection = {
      type: "FeatureCollection";
      features: MapFeature[];
    };
    type ViewState = "landing" | "state-network" | "regional";
    type StationMode = "hidden" | "state" | "regional";
    type RouteId =
      | "black"
      | "blue"
      | "yellow"
      | "pink"
      | "purple"
      | "orange";
    type StoreTileEntry = {
      storeId: string;
      modelGroup: THREE.Group;
      storeModel: THREE.Group;
      baseModelScale: number;
      stateMarkerGroup: THREE.Group;
      stateMarkerModel: THREE.Group;
      stateMarkerScale: number;
      regionId: string;
    };
    type StoreTileLayer = {
      id: string;
      type: "custom";
      renderingMode: "3d";
      onAdd: (
        mapArg: MapLibreMap,
        gl: WebGLRenderingContext | WebGL2RenderingContext,
      ) => void;
      render: (
        gl: WebGLRenderingContext | WebGL2RenderingContext,
        args: unknown,
      ) => void;
      onRemove: () => void;
      setMode: (mode: StationMode, regionId?: string) => void;
      setHoveredStore: (storeId: string | null) => void;
      pulseStore: (storeId: string) => void;
      setRoute: (
        routeId: RouteId,
        coordinates: GeoJsonPosition[] | null,
      ) => void;
    };

    const svgSnapPrecision = 0.001;
    const openFreeMapStyleUrl = "https://tiles.openfreemap.org/styles/bright";
    const storeModelUrl = "/models/HEB_Store.glb";
    const stateMarkerModelUrl = "/models/HEB_cowboy_hat.glb";
    const trainModelUrl = "/models/HEB_train_and_tracks.glb";
    const regularStoreFootprintMeters = 1240;
    const hubStoreFootprintMeters = 1620;
    // ─── Density-based footprint scaling ─────────────────────────────
    // For sparse regions (West Texas, North Texas) the regional fly-in
    // lands at a wide zoom and the default 1240m store reads as a
    // speck. We measure each store's distance to its NEAREST sibling
    // inside the same region and pick a multiplier from a bucketed
    // scale: closer neighbors mean smaller buildings (to avoid
    // overlap), further neighbors mean huge buildings (so the user
    // can see + click them). Per-city overrides win when a city's two
    // stores sit so close together that even the smallest bucket
    // would overlap (Del Rio).
    //
    // Regions outside this set keep the default 1× footprint — they're
    // already dense enough that bumping them risks unintended overlap.
    const RESIZED_REGIONS = new Set<string>([
      "west",
      "north",
      "east",
      "gulf",
      "south",
      "central",
    ]);
    const STORE_MULTIPLIER_OVERRIDES: Record<string, number> = {
      // Del Rio's two stores sit ~0.95 km apart — closer than the
      // default building footprint. Anything ≥ 1× overlaps; 0.6×
      // (744m each) gives ~200 m clearance.
      "Del Rio": 0.6,
    };
    const regularStateMarkerFootprintMeters = 18000;
    const hubStateMarkerFootprintMeters = 24000;
    // Train footprint and speed.
    // - 4500 m footprint = same order as the cowboy hats so the train reads
    //   from the state-network zoom AND stays sensibly sized in regional.
    // - 28000 m/s ≈ 100,800 km/h. Wildly unrealistic, but the camera
    //   sees a continent; a real train speed would look frozen. Tuned to
    //   cross a typical region in ~6s and the whole state in ~30s.
    const trainFootprintMeters = 4500;
    const trainSpeedMps = 28000;
    // Time the train sits at each station before continuing — "picking up
    // passengers". Applied at every station including the two route
    // endpoints (i.e. the reverse-direction bounce now happens AFTER the
    // pause, not instead of it). Tune freely.
    const trainStationPauseMs = 750;
    // After load, the train model is auto-aligned so its long axis points
    // along scene +X (which we treat as "nose forward"). If the GLB was
    // authored with the cab at the −X end of the long axis instead, the
    // train will run rear-first. Flip this to π to spin the nose 180°
    // without re-exporting the GLB. π/2 / −π/2 are also valid if the
    // auto-alignment somehow guesses wrong.
    const trainFacingOffsetRad = 0;
    const mapStateZoom = 5.1;
    const mapRegionalZoom = 10.25;
    const mapRegionalAnchorZoom = 12.85;
    const mapPitch = 45;
    const regionalPitch = 66;
    const stateBearing = 0;
    const regionalBearing = -18;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const mapSourceIds = {
      regions: "heb-texas-regions",
      stations: "heb-station-buildings",
      routes: "heb-future-routes",
    };
    const mapLayerIds = {
      regions: "texas-regions-fill",
      borders: "texas-regions-borders",
      routes: "shinkansen-transit-lines",
      stations: "heb-station-3d-buildings",
      storeTiles: "heb-store-3d-tiles",
    };
    const texasRegionSpecs: TexasRegionSpec[] = [
      {
        id: "panhandle",
        name: "Panhandle",
        clips: [
          [
            { x: 145, y: -80 },
            { x: 263, y: -80 },
            { x: 263, y: 136 },
            { x: 145, y: 136 },
          ],
        ],
      },
      {
        id: "west",
        name: "West Texas",
        clips: [
          [
            { x: -80, y: 136 },
            { x: 263, y: 136 },
            { x: 263, y: 600 },
            { x: -80, y: 600 },
          ],
        ],
      },
      {
        id: "north",
        name: "North Texas",
        clips: [
          [
            { x: 263, y: 110 },
            { x: 400, y: 110 },
            { x: 400, y: 240 },
            { x: 263, y: 240 },
          ],
        ],
      },
      {
        id: "central",
        name: "Central Texas",
        clips: [
          [
            { x: 263, y: 240 },
            { x: 400, y: 240 },
            { x: 400, y: 345 },
            { x: 263, y: 345 },
          ],
        ],
      },
      {
        id: "east",
        name: "East Texas",
        clips: [
          [
            { x: 400, y: 110 },
            { x: 560, y: 110 },
            { x: 560, y: 300 },
            { x: 400, y: 300 },
          ],
        ],
      },
      {
        id: "gulf",
        name: "Gulf Coast",
        clips: [
          [
            { x: 400, y: 300 },
            { x: 560, y: 300 },
            { x: 560, y: 600 },
            { x: 400, y: 600 },
          ],
        ],
      },
      {
        id: "south",
        name: "South Texas",
        clips: [
          [
            { x: 263, y: 345 },
            { x: 400, y: 345 },
            { x: 400, y: 600 },
            { x: 263, y: 600 },
          ],
        ],
      },
    ];
    const regionalAnchorStoreIds: Partial<Record<string, string>> = {
      panhandle: "lubbock-4405-114th-street-48",
      west: "midland-3325-west-wadley-63",
      north: "plano-6001-preston-road-suite-100-8",
      central: "austin-2400-s-congress-ave-258",
      east: "lufkin-111-north-timberland-drive-201",
      gulf: "houston-2300-n-shepherd-dr-158",
      south: "mcallen-901-trenton-rd-126",
    };

    const texasOutlinePoints = parseSvgPathPoints(texasPath);
    const texasOutlineBounds = getSvgPointBounds(texasOutlinePoints);
    const globalMercatorFrame = createGlobalMercatorFrame(
      hebStores,
      texasOutlineBounds,
    );
    const regionDefinitions = createRegionDefinitions();
    const storeDefinitions = createStoreDefinitions();
    const texasBounds = getFeatureCollectionBounds(
      createRegionFeatureCollection(),
    );

    // Precompute each resized-region store's distance to its nearest
    // same-region neighbor. O(n²) over the resized regions only, so it
    // runs in microseconds at startup. Haversine is inlined here
    // because the shared `haversineKm` function is declared later in
    // the file and module-strict block-scoping puts it in TDZ at this
    // point — calling it would throw and abort the whole script (which
    // is why the map briefly stopped rendering).
    const nearestNeighborKmByStoreId = (() => {
      const EARTH_KM = 6371.0088;
      const toRad = (d: number) => (d * Math.PI) / 180;
      const dist = (
        lng1: number,
        lat1: number,
        lng2: number,
        lat2: number,
      ) => {
        const dLat = toRad(lat2 - lat1);
        const dLng = toRad(lng2 - lng1);
        const phi1 = toRad(lat1);
        const phi2 = toRad(lat2);
        const sinDLat = Math.sin(dLat / 2);
        const sinDLng = Math.sin(dLng / 2);
        const a =
          sinDLat * sinDLat +
          Math.cos(phi1) * Math.cos(phi2) * sinDLng * sinDLng;
        return 2 * EARTH_KM * Math.asin(Math.min(1, Math.sqrt(a)));
      };
      const map = new Map<string, number>();
      storeDefinitions.forEach((store) => {
        if (!RESIZED_REGIONS.has(store.regionId)) return;
        let minKm = Infinity;
        storeDefinitions.forEach((other) => {
          if (other.id === store.id) return;
          if (other.regionId !== store.regionId) return;
          const d = dist(store.lng, store.lat, other.lng, other.lat);
          if (d < minKm) minKm = d;
        });
        map.set(store.id, minKm);
      });
      return map;
    })();

    function computeStoreFootprintMultiplier(
      store: (typeof storeDefinitions)[number],
    ) {
      if (!RESIZED_REGIONS.has(store.regionId)) return 1;
      const explicit = STORE_MULTIPLIER_OVERRIDES[store.city];
      if (explicit !== undefined) return explicit;
      const minDistKm =
        nearestNeighborKmByStoreId.get(store.id) ?? Infinity;
      // Bucketed scale. The two tightest buckets exist mainly for the
      // Houston / Gulf Coast cluster, where stores routinely sit
      // 2-4 km apart — bumping those to the 2.0× bucket would push
      // their buildings into each other. West/North pairs (Midland
      // 3.8 km, San Angelo 3.3 km, Waco-cluster ~5 km) sit above the
      // 3 km cutoff and still get the same 2.0× they had before, so
      // these new buckets don't shrink anything you'd already approved.
      if (minDistKm < 2) return 1.0; //  → 1.24 km (very-tight pairs)
      if (minDistKm < 3) return 1.5; //  → 1.86 km (tight Houston pairs)
      if (minDistKm < 5) return 2.0; //  → 2.48 km (Midland, San Angelo, Waco)
      if (minDistKm < 15) return 4.0; //  → 4.96 km (DFW cluster, Odessa pair)
      if (minDistKm < 40) return 5.0; //  → 6.20 km (Stephenville-ish)
      if (minDistKm < 80) return 6.0; //  → 7.44 km
      return 8.0; //                     → 9.92 km (Abilene, Lubbock, Big Spring)
    }

    type SelectedStation = {
      id: string;
      name: string;
      address: string;
      city: string;
      zip: string;
      regionId: string;
      regionName: string;
    };

    // Six color-coded routes. The user can build any combination of them;
    // each owns its own selection list, its own dashed line on the map,
    // and its own 3D train (a train clone wearing a cowboy hat tinted to
    // the route's hatColor). Order here is the order they appear in the
    // accordion. Black is the "default" route and inherits the white hat
    // (the original cowboy-hat-asset color) so it doesn't get re-tinted.
    type RouteConfig = {
      id: RouteId;
      label: string;
      lineColor: string;
      hatColor: string;
      // Text color used on top of `lineColor` for the hamburger button.
      // Yellow is the only background light enough to need dark text;
      // every other route gets white.
      textColor: string;
    };
    const ROUTE_IDS: RouteId[] = [
      "black",
      "blue",
      "yellow",
      "pink",
      "purple",
      "orange",
    ];
    const routeConfigs: Record<RouteId, RouteConfig> = {
      black: {
        id: "black",
        label: "Route 1",
        lineColor: "#0a0a0a",
        hatColor: "#ffffff",
        textColor: "#ffffff",
      },
      blue: {
        id: "blue",
        label: "Route 2",
        lineColor: "#1f6fc4",
        hatColor: "#1f6fc4",
        textColor: "#ffffff",
      },
      yellow: {
        id: "yellow",
        label: "Route 3",
        lineColor: "#f5b400",
        hatColor: "#f5b400",
        textColor: "#1a1a1a",
      },
      pink: {
        id: "pink",
        label: "Route 4",
        lineColor: "#ec4899",
        hatColor: "#ec4899",
        textColor: "#ffffff",
      },
      purple: {
        id: "purple",
        label: "Route 5",
        lineColor: "#7c47d6",
        hatColor: "#7c47d6",
        textColor: "#ffffff",
      },
      orange: {
        id: "orange",
        label: "Route 6",
        lineColor: "#ff6a1f",
        hatColor: "#ff6a1f",
        textColor: "#ffffff",
      },
    };
    const railroadSourceIdFor = (id: RouteId) => `heb-railroad-route-${id}`;
    const railroadLayerIdFor = (id: RouteId) => `heb-railroad-track-${id}`;

    let map: MapLibreMap | undefined;
    let mapReady = false;
    let viewState: ViewState = "landing";
    let currentRegionId: string | null = null;
    let returnViewState: Exclude<ViewState, "regional"> = "landing";
    let isTransitioning = false;
    let storeTileLayer: StoreTileLayer | undefined;
    // Per-route selection arrays. Black starts as the active route so the
    // first click after launch lands in Route 1.
    const routeStations: Record<RouteId, SelectedStation[]> = {
      black: [],
      blue: [],
      yellow: [],
      pink: [],
      purple: [],
      orange: [],
    };
    let activeRouteId: RouteId = "black";
    // Tracks the store id currently under the cursor on the stations layer so
    // we can drive the 3D hover animation. MapLibre fires `mousemove` over a
    // layer many times per second; we early-return when the id doesn't change.
    let hoveredStationId: string | null = null;

    initRouteAccordion();
    map = createMap();
    introCopy.addEventListener("click", revealStateNetwork);
    introCopy.addEventListener("keydown", handleIntroKeydown);
    regionReturn.addEventListener("click", returnToStateView);
    document.addEventListener("astro:before-swap", disposeMap, { once: true });

    // Build the six accordion sections (one per route) from the
    // routeConfigs dict. Each section gets a colored badge, a label, a
    // count, a caret, and an empty selection list inside. The active
    // route is marked via `data-route-active="true"` on the section so
    // the CSS can style + reveal it; strict-accordion expansion is also
    // pure CSS (max-height transition gated by that data attribute).
    function initRouteAccordion() {
      ROUTE_IDS.forEach((id) => {
        const cfg = routeConfigs[id];
        const section = document.createElement("section");
        section.className = "heb-landing__route-section";
        // "active" = which route new map-clicks add to.
        // "open"   = whether this section's body is currently shown.
        // They're independent: a user can collapse the active route and
        // still have new clicks land there, or expand multiple routes
        // at once to compare them. Initial state: black is active, all
        // sections start closed (cleaner on first open of the panel).
        section.dataset.routeSection = id;
        section.dataset.routeActive = id === activeRouteId ? "true" : "false";
        section.dataset.routeOpen = "false";
        section.style.setProperty("--route-color", cfg.lineColor);
        section.style.setProperty("--route-hat-color", cfg.hatColor);
        section.style.setProperty("--route-text-color", cfg.textColor);

        const header = document.createElement("button");
        header.type = "button";
        header.className = "heb-landing__route-header";
        header.dataset.routeToggle = id;
        header.setAttribute("aria-expanded", "false");
        header.setAttribute("aria-controls", `route-body-${id}`);
        // Inline the critical color + typography styles. The previous
        // version relied on CSS variables alone, and external CSS won
        // specificity on the user's render. Inline styles guarantee
        // both the route color AND the volks-typo signage typography
        // (Oswald, uppercase, tracked) actually land.
        header.style.background = cfg.lineColor;
        header.style.color = cfg.textColor;
        header.style.borderColor = "rgba(0, 0, 0, 0.22)";
        header.style.fontFamily =
          "Oswald, 'Roboto Condensed', system-ui, sans-serif";
        header.style.fontWeight = "700";
        header.style.letterSpacing = "0.18em";
        header.style.textTransform = "uppercase";

        // Header layout: label (Oswald uppercase) + ETA pill + chevron.
        // No count is shown here — previously the "0" floated right
        // next to "Route 1" and read as "Route 10". Per-route count is
        // implicit in the list items; the panel-level total is in the
        // panel header.
        const label = document.createElement("span");
        label.className = "heb-landing__route-label";
        label.textContent = cfg.label;
        // Inline-style the volks-typo signage typography so external
        // CSS can't override the Bauhaus heading look on the labels.
        label.style.fontFamily =
          "Oswald, 'Roboto Condensed', system-ui, sans-serif";
        label.style.fontWeight = "700";
        label.style.letterSpacing = "0.18em";
        label.style.textTransform = "uppercase";

        // ETA pill — populated by updateSelectionMeta whenever the
        // route mutates. Stays empty (and hidden via :empty CSS) when
        // the route has fewer than two stations. Inline-styled with
        // the route's TEXT color as the pill background and the
        // route's LINE color as the text inside, giving each route a
        // distinct "stamp" that reads as that route's color identity.
        const eta = document.createElement("span");
        eta.className = "heb-landing__route-eta";
        eta.dataset.routeEta = id;
        eta.setAttribute("aria-hidden", "true");
        eta.style.background = cfg.textColor;
        eta.style.color = cfg.lineColor;

        const icon = document.createElement("span");
        icon.className = "heb-landing__route-icon";
        icon.setAttribute("aria-hidden", "true");
        // Chevron-down glyph. Rotates 180° via CSS when the section is
        // open, so the affordance reads as a classic dropdown toggle.
        icon.textContent = "▾";

        header.append(label, eta, icon);

        const body = document.createElement("div");
        body.className = "heb-landing__route-body";
        body.dataset.routeBody = id;
        body.id = `route-body-${id}`;
        // Inline `display: none` guarantees the body starts collapsed
        // regardless of what any external stylesheet does to
        // .heb-landing__route-body. `setRouteOpen` flips this back to
        // "" (empty string = inherit the stylesheet default) when the
        // section opens.
        body.style.display = "none";

        const list = document.createElement("ol");
        list.className = "heb-landing__selection-list";
        list.dataset.selectionList = id;
        list.setAttribute("role", "list");

        const empty = document.createElement("p");
        empty.className = "heb-landing__selection-empty";
        empty.dataset.selectionEmpty = id;
        empty.textContent = "Click stations on the map to add them.";

        body.append(list, empty);
        section.append(header, body);
        accordionContainer.appendChild(section);

        header.addEventListener("click", () => toggleRouteOpen(id));
      });
    }

    // Click on a route header: mark that route active (so new map
    // clicks land there) AND flip whether its section is open. Each
    // section toggles independently — multiple can be open at once,
    // and the active route can be collapsed if you like.
    function toggleRouteOpen(routeId: RouteId) {
      setActiveRoute(routeId);
      const section = root.querySelector<HTMLElement>(
        `[data-route-section="${routeId}"]`,
      );
      if (!section) return;
      const wasOpen = section.dataset.routeOpen === "true";
      setRouteOpen(routeId, !wasOpen);
    }

    // Imperative setter — used by addSelectedStation to auto-expand on
    // adds, and could be reused for any future "open this route from
    // code" path.
    function setRouteOpen(routeId: RouteId, open: boolean) {
      const section = root.querySelector<HTMLElement>(
        `[data-route-section="${routeId}"]`,
      );
      if (!section) return;
      section.dataset.routeOpen = open ? "true" : "false";
      const body = section.querySelector<HTMLElement>("[data-route-body]");
      if (body) {
        // Drive visibility via inline `display` — this beats every
        // external stylesheet without using `!important`. A previous
        // attempt relied solely on CSS attribute selectors and the
        // toggle wasn't visible because something in the cascade
        // overrode the collapsed state. Inline styles win the cascade
        // without escalation.
        body.style.display = open ? "block" : "none";
      }
      const header = section.querySelector<HTMLButtonElement>(
        "[data-route-toggle]",
      );
      header?.setAttribute("aria-expanded", open ? "true" : "false");
    }

    function setActiveRoute(routeId: RouteId) {
      activeRouteId = routeId;
      ROUTE_IDS.forEach((id) => {
        const section = root.querySelector<HTMLElement>(
          `[data-route-section="${id}"]`,
        );
        if (!section) return;
        section.dataset.routeActive = id === routeId ? "true" : "false";
      });
    }

    function createMap() {
      const instance = new maplibregl.Map({
        container: mapHost,
        style: openFreeMapStyleUrl,
        center: texasBounds.getCenter(),
        zoom: mapStateZoom,
        pitch: mapPitch,
        bearing: stateBearing,
        interactive: true,
        dragPan: true,
        dragRotate: true,
        touchZoomRotate: true,
        scrollZoom: true,
        doubleClickZoom: true,
        keyboard: true,
        maxPitch: 80,
        attributionControl: false,
        maplibreLogo: false,
        canvasContextAttributes: {
          alpha: true,
          antialias: true,
          powerPreference: "high-performance",
        },
      });

      instance.on("load", () => {
        mapReady = true;
        hideBaseStyleHighwayShields(instance);
        addMapLayers();
        configureMapLight();
        showLanding(false);
      });
      instance.on("zoom", syncLodFromZoom);
      // NOTE: we intentionally do NOT couple any logic to the global
      // "moveend" event. That event fires for ANY camera motion ending —
      // wheel-zooms, pans, our scripted flyTo, etc. Coupling completion
      // callbacks to moveend caused a wheel-then-click race where the
      // wheel-zoom's moveend would consume a pending callback before the
      // scripted flyTo even started visibly, skipping the fly-in. The
      // setTimeout in completeAfterMove is the sole completion trigger
      // now, which is timer-based and immune to that race.
      instance.on("click", mapLayerIds.regions, handleRegionMapClick);
      instance.on("mouseenter", mapLayerIds.regions, () => {
        instance.getCanvas().style.cursor = "pointer";
      });
      instance.on("mouseleave", mapLayerIds.regions, () => {
        instance.getCanvas().style.cursor = "";
      });
      instance.on("mouseenter", mapLayerIds.stations, () => {
        instance.getCanvas().style.cursor = "pointer";
      });
      instance.on("mousemove", mapLayerIds.stations, handleStationMouseMove);
      instance.on("mouseleave", mapLayerIds.stations, () => {
        instance.getCanvas().style.cursor = "";
        // Clear hover state when the cursor leaves the layer entirely so the
        // last-hovered building scales back to its base size.
        hoveredStationId = null;
        storeTileLayer?.setHoveredStore(null);
      });
      instance.on("click", mapLayerIds.stations, handleStationMapClick);

      return instance;
    }

    function addMapLayers() {
      if (!map || map.getSource(mapSourceIds.regions)) {
        return;
      }

      const labelLayerId = getFirstLabelLayerId();

      map.addSource(mapSourceIds.regions, {
        type: "geojson",
        data: createRegionFeatureCollection() as never,
      });
      map.addSource(mapSourceIds.stations, {
        type: "geojson",
        data: createStationFeatureCollection() as never,
      });
      map.addSource(mapSourceIds.routes, {
        type: "geojson",
        data: createEmptyFeatureCollection() as never,
      });
      // One GeoJSON source per route. Each one carries the dashed
      // LineString built from its route's selected stations.
      ROUTE_IDS.forEach((routeId) => {
        map?.addSource(railroadSourceIdFor(routeId), {
          type: "geojson",
          data: createEmptyFeatureCollection() as never,
        });
      });

      map.addLayer(
        {
          id: mapLayerIds.regions,
          type: "fill",
          source: mapSourceIds.regions,
          paint: {
            "fill-color": "#e11921",
            "fill-opacity": 1,
          },
        },
        labelLayerId,
      );

      map.addLayer(
        {
          id: mapLayerIds.borders,
          type: "line",
          source: mapSourceIds.regions,
          layout: {
            "line-cap": "round",
            "line-join": "round",
          },
          paint: {
            "line-color": "#050505",
            "line-opacity": 0.9,
            "line-width": [
              "interpolate",
              ["linear"],
              ["zoom"],
              4,
              0.8,
              6,
              1.35,
              9,
              2.2,
              12,
              3.2,
            ],
          },
        },
        labelLayerId,
      );

      map.addLayer(
        {
          id: mapLayerIds.routes,
          type: "line",
          source: mapSourceIds.routes,
          layout: {
            "line-cap": "round",
            "line-join": "round",
          },
          paint: {
            "line-color": "#ffffff",
            "line-opacity": 0,
            "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.5, 9, 4],
          },
        },
        labelLayerId,
      );

      // One dashed line layer per route, each painted in its route's
      // configured color. `updateRailroadRoute(routeId)` sets / clears
      // each source's data when its route's selection mutates. All
      // routes are visible simultaneously (per design); the active
      // route is identified via the accordion in the side panel.
      ROUTE_IDS.forEach((routeId) => {
        const cfg = routeConfigs[routeId];
        map?.addLayer(
          {
            id: railroadLayerIdFor(routeId),
            type: "line",
            source: railroadSourceIdFor(routeId),
            layout: {
              "line-cap": "butt",
              "line-join": "miter",
            },
            paint: {
              "line-color": cfg.lineColor,
              "line-opacity": 0.92,
              "line-width": [
                "interpolate",
                ["linear"],
                ["zoom"],
                4,
                1.6,
                7,
                2.6,
                10,
                4,
                13,
                5.5,
              ],
              "line-dasharray": [2, 2],
            },
          },
          labelLayerId,
        );
      });

      map.addLayer(
        {
          id: mapLayerIds.stations,
          type: "fill-extrusion",
          source: mapSourceIds.stations,
          paint: {
            "fill-extrusion-color": "#ffffff",
            "fill-extrusion-height": [
              "interpolate",
              ["linear"],
              ["zoom"],
              5,
              45,
              8,
              200,
              10,
              520,
              13,
              900,
            ],
            "fill-extrusion-base": 0,
            "fill-extrusion-opacity": 0,
            "fill-extrusion-vertical-gradient": true,
          },
        },
        labelLayerId,
      );

      storeTileLayer = createStoreTileLayer();
      map.addLayer(storeTileLayer, labelLayerId);
    }

    function getFirstLabelLayerId() {
      const layers = map?.getStyle().layers ?? [];
      const labelLayer = layers.find(
        (layer) =>
          layer.type === "symbol" && Boolean(layer.layout?.["text-field"]),
      );
      return labelLayer?.id;
    }

    // Walk the base style's loaded layers and hide the highway-shield
    // badges (e.g. "281", "290", "CR 410"). We target only `symbol`
    // layers that have an `icon-image` AND come from a road/transport
    // source-layer — that keeps the road LINES, road TEXT labels, and
    // non-road icons (city pins etc.) all intact, while killing the
    // distracting numeric shields you saw in the regional view.
    function hideBaseStyleHighwayShields(mapInstance: MapLibreMap) {
      const layers = mapInstance.getStyle().layers ?? [];
      layers.forEach((layer) => {
        if (layer.type !== "symbol") return;
        const iconImage = layer.layout?.["icon-image"];
        if (!iconImage) return;
        const sourceLayer = (layer as { "source-layer"?: string })[
          "source-layer"
        ];
        const id = layer.id.toLowerCase();
        const isRoadIcon =
          sourceLayer === "transportation" ||
          sourceLayer === "transportation_name" ||
          id.includes("highway") ||
          id.includes("shield") ||
          id.includes("road") ||
          id.includes("motorway");
        if (!isRoadIcon) return;
        try {
          mapInstance.setLayoutProperty(layer.id, "visibility", "none");
        } catch {
          // Some styles disallow setLayoutProperty on certain layers
          // (rare, but defensive — we don't want one weird layer to
          // throw and abort the whole load callback).
        }
      });
    }

    function configureMapLight() {
      map?.setLight({
        anchor: "viewport",
        position: [1.35, 145, 45],
        color: "#ffffff",
        intensity: 0.72,
      });
    }

    function createStoreTileLayer(): StoreTileLayer {
      let scene: THREE.Scene | undefined;
      let camera: THREE.Camera | undefined;
      let renderer: THREE.WebGLRenderer | undefined;
      let mapInstance: MapLibreMap | undefined;
      let disposed = false;
      let activeMode: StationMode =
        viewState === "regional"
          ? "regional"
          : viewState === "landing"
            ? "hidden"
            : "state";
      let activeRegionId: string | undefined = currentRegionId ?? undefined;
      let loggedStoreModelBounds = false;
      let hasPlayedStateMarkerReveal = false;
      let stateMarkerRevealFrame = 0;
      const tileEntries: StoreTileEntry[] = [];
      const tileEntriesById = new Map<string, StoreTileEntry>();
      const ownedGeometries = new Set<THREE.BufferGeometry>();
      const ownedMaterials = new Set<THREE.Material>();
      const hoverScaleFactor = 1.18;
      const pulseScaleFactor = 1.32;
      const hoverDurationMs = 220;
      const pulseDurationMs = 420;
      let hoveredStoreId: string | null = null;
      const activePulseStoreIds = new Set<string>();

      // ── Train state ──────────────────────────────────────────────
      // One TrainState per route. Each carries its own GLB clone (with a
      // colored cowboy hat attached), its own polyline cache, and its
      // own progress / pause bookkeeping. `tickTrains()` walks every
      // route on each render frame; routes with `routeActive=false`
      // short-circuit immediately so unused routes cost nothing.
      type TrainSegment = {
        startLng: number;
        startLat: number;
        endLng: number;
        endLat: number;
        startMercX: number;
        startMercY: number;
        endMercX: number;
        endMercY: number;
        length: number;
        cumulativeStart: number;
      };
      type TrainState = {
        routeId: RouteId;
        group: THREE.Group | null;
        modelRoot: THREE.Group | null;
        hatGroup: THREE.Group | null;
        baseFootprintScale: number;
        segments: TrainSegment[];
        stationDistances: number[];
        totalLengthMeters: number;
        progressMeters: number;
        direction: 1 | -1;
        lastTickMs: number;
        pauseEndsAt: number;
        lastPausedStationIndex: number;
        routeActive: boolean;
      };
      const trains: Record<RouteId, TrainState> = ROUTE_IDS.reduce(
        (acc, id) => {
          acc[id] = {
            routeId: id,
            group: null,
            modelRoot: null,
            hatGroup: null,
            baseFootprintScale: 1,
            segments: [],
            stationDistances: [],
            totalLengthMeters: 0,
            progressMeters: 0,
            direction: 1,
            lastTickMs: 0,
            pauseEndsAt: 0,
            lastPausedStationIndex: -1,
            routeActive: false,
          };
          return acc;
        },
        {} as Record<RouteId, TrainState>,
      );
      // Shared cowboy-hat template. Populated by `loadStoreModel` when
      // the GLB lands; `loadTrainModel` clones a tinted copy from this
      // for each train. Stored at layer scope so the two load paths
      // can share the same normalized result.
      let normalizedHatTemplate:
        | { root: THREE.Group; size: THREE.Vector3 }
        | null = null;
      const EARTH_RADIUS_M = 6371008.8;

      const haversineMeters = (
        lng1: number,
        lat1: number,
        lng2: number,
        lat2: number,
      ) => {
        const toRad = (deg: number) => (deg * Math.PI) / 180;
        const dLat = toRad(lat2 - lat1);
        const dLng = toRad(lng2 - lng1);
        const phi1 = toRad(lat1);
        const phi2 = toRad(lat2);
        const sinDLat = Math.sin(dLat / 2);
        const sinDLng = Math.sin(dLng / 2);
        const a =
          sinDLat * sinDLat +
          Math.cos(phi1) * Math.cos(phi2) * sinDLng * sinDLng;
        return 2 * EARTH_RADIUS_M * Math.asin(Math.min(1, Math.sqrt(a)));
      };

      const buildTrainSegments = (coords: GeoJsonPosition[]) => {
        const segments: TrainSegment[] = [];
        const stationDists: number[] = [0];
        let cumulative = 0;
        for (let i = 0; i < coords.length - 1; i += 1) {
          const [lng1, lat1] = coords[i];
          const [lng2, lat2] = coords[i + 1];
          const start = maplibregl.MercatorCoordinate.fromLngLat(
            [lng1, lat1],
            0,
          );
          const end = maplibregl.MercatorCoordinate.fromLngLat(
            [lng2, lat2],
            0,
          );
          const length = haversineMeters(lng1, lat1, lng2, lat2);
          segments.push({
            startLng: lng1,
            startLat: lat1,
            endLng: lng2,
            endLat: lat2,
            startMercX: start.x,
            startMercY: start.y,
            endMercX: end.x,
            endMercY: end.y,
            length,
            cumulativeStart: cumulative,
          });
          cumulative += length;
          stationDists.push(cumulative);
        }
        return { segments, total: cumulative, stationDists };
      };

      // Returns mercator XY + heading + per-point meter scale at the
      // given distance along the supplied segments. Returns null if no
      // segments are cached. Heading is in radians measured in mercator
      // space (atan2(dy, dx)); since mercator Y grows southward, a
      // northbound train has negative dy — which is correct for the
      // Three.js Z-up rotation we apply.
      const positionAlongRoute = (state: TrainState, distanceMeters: number) => {
        if (state.segments.length === 0) return null;
        const d = Math.max(
          0,
          Math.min(state.totalLengthMeters, distanceMeters),
        );
        let chosen = state.segments[state.segments.length - 1];
        for (const seg of state.segments) {
          if (d <= seg.cumulativeStart + seg.length) {
            chosen = seg;
            break;
          }
        }
        const segLen = chosen.length || 1;
        const t = Math.max(0, Math.min(1, (d - chosen.cumulativeStart) / segLen));
        const mercX =
          chosen.startMercX + (chosen.endMercX - chosen.startMercX) * t;
        const mercY =
          chosen.startMercY + (chosen.endMercY - chosen.startMercY) * t;
        const heading = Math.atan2(
          chosen.endMercY - chosen.startMercY,
          chosen.endMercX - chosen.startMercX,
        );
        const lng =
          chosen.startLng + (chosen.endLng - chosen.startLng) * t;
        const lat =
          chosen.startLat + (chosen.endLat - chosen.startLat) * t;
        const meterScale = maplibregl.MercatorCoordinate.fromLngLat(
          [lng, lat],
          0,
        ).meterInMercatorCoordinateUnits();
        return { mercX, mercY, heading, meterScale };
      };

      const applyTrainPose = (state: TrainState) => {
        if (!state.group) return;
        if (!state.routeActive || state.segments.length === 0) {
          state.group.visible = false;
          return;
        }
        const p = positionAlongRoute(state, state.progressMeters);
        if (!p) return;
        state.group.visible = true;
        state.group.position.set(p.mercX, p.mercY, 0);
        state.group.scale.setScalar(p.meterScale * state.baseFootprintScale);
        const reverseFlip = state.direction === -1 ? Math.PI : 0;
        state.group.rotation.set(
          0,
          0,
          p.heading + reverseFlip + trainFacingOffsetRad,
        );
      };

      const tickTrain = (state: TrainState) => {
        if (
          !state.routeActive ||
          !state.group ||
          state.totalLengthMeters <= 0 ||
          state.segments.length === 0
        ) {
          state.lastTickMs = 0;
          return;
        }
        const now = performance.now();

        // ── Pause handling ──────────────────────────────────────────
        if (state.pauseEndsAt > 0) {
          if (now < state.pauseEndsAt) {
            state.lastTickMs = now;
            return;
          }
          state.pauseEndsAt = 0;
          if (state.lastPausedStationIndex === state.stationDistances.length - 1) {
            state.direction = -1;
          } else if (state.lastPausedStationIndex === 0) {
            state.direction = 1;
          }
          state.progressMeters = Math.max(
            0,
            Math.min(
              state.totalLengthMeters,
              state.progressMeters + state.direction * 0.5,
            ),
          );
          state.lastPausedStationIndex = -1;
          state.lastTickMs = now;
        }

        if (state.lastTickMs === 0) {
          state.lastTickMs = now;
        }
        const dt = Math.min(0.1, (now - state.lastTickMs) / 1000);
        state.lastTickMs = now;

        const oldProgress = state.progressMeters;
        const stepped = oldProgress + state.direction * trainSpeedMps * dt;

        // ── Station-crossing detection ──────────────────────────────
        let hitIdx = -1;
        let hitDist = -1;
        for (let i = 0; i < state.stationDistances.length; i += 1) {
          const d = state.stationDistances[i];
          if (state.direction === 1) {
            if (d > oldProgress && d <= stepped) {
              if (hitIdx === -1 || d < hitDist) {
                hitIdx = i;
                hitDist = d;
              }
            }
          } else if (state.direction === -1) {
            if (d < oldProgress && d >= stepped) {
              if (hitIdx === -1 || d > hitDist) {
                hitIdx = i;
                hitDist = d;
              }
            }
          }
        }

        if (hitIdx !== -1) {
          state.progressMeters = hitDist;
          state.pauseEndsAt = now + trainStationPauseMs;
          state.lastPausedStationIndex = hitIdx;
          applyTrainPose(state);
          return;
        }

        // ── Defensive endpoint clamp ───────────────────────────────
        let newProgress = stepped;
        if (newProgress > state.totalLengthMeters) {
          newProgress = state.totalLengthMeters;
          state.pauseEndsAt = now + trainStationPauseMs;
          state.lastPausedStationIndex = state.stationDistances.length - 1;
        } else if (newProgress < 0) {
          newProgress = 0;
          state.pauseEndsAt = now + trainStationPauseMs;
          state.lastPausedStationIndex = 0;
        }

        state.progressMeters = newProgress;
        applyTrainPose(state);
      };

      // Per-frame entry point: tick every route's train. Routes that
      // aren't active (routeActive=false) early-return inside tickTrain
      // and cost essentially nothing.
      const tickTrains = () => {
        ROUTE_IDS.forEach((id) => tickTrain(trains[id]));
      };

      const setRoute = (
        routeId: RouteId,
        coordinates: GeoJsonPosition[] | null,
      ) => {
        const state = trains[routeId];
        if (!coordinates || coordinates.length < 2) {
          state.routeActive = false;
          state.segments = [];
          state.stationDistances = [];
          state.totalLengthMeters = 0;
          state.progressMeters = 0;
          state.direction = 1;
          state.lastTickMs = 0;
          state.pauseEndsAt = 0;
          state.lastPausedStationIndex = -1;
          if (state.group) state.group.visible = false;
          mapInstance?.triggerRepaint();
          return;
        }
        const { segments, total, stationDists } =
          buildTrainSegments(coordinates);
        state.segments = segments;
        state.stationDistances = stationDists;
        state.totalLengthMeters = total;
        // "Continue from current position" — clamp existing progress to
        // the new total length so the train picks up from wherever it
        // was on the previous polyline.
        state.progressMeters = Math.max(
          0,
          Math.min(state.progressMeters, total),
        );
        state.pauseEndsAt = 0;
        state.lastPausedStationIndex = -1;
        const sittingAt = stationDists.findIndex(
          (d) => Math.abs(d - state.progressMeters) < 1,
        );
        if (sittingAt !== -1) {
          state.pauseEndsAt = performance.now() + trainStationPauseMs;
          state.lastPausedStationIndex = sittingAt;
        }
        state.routeActive = true;
        applyTrainPose(state);
        mapInstance?.triggerRepaint();
      };

      // Builds a tinted clone of the cowboy-hat template to sit on top of
      // each train. The hat's materials are CLONED before tinting so the
      // six per-route hats don't share a material — otherwise tinting
      // one would tint them all.
      const buildTrainHat = (
        template: { root: THREE.Group; size: THREE.Vector3 },
        hatColor: string,
        trainSize: THREE.Vector3,
      ) => {
        const hatRoot = template.root.clone(true);
        hatRoot.traverse((object) => {
          const mesh = object as THREE.Mesh;
          if (!mesh.isMesh) return;
          const cloneMat = (m: THREE.Material) => {
            const c = m.clone();
            const tintable = c as THREE.MeshStandardMaterial & {
              color?: THREE.Color;
              emissive?: THREE.Color;
              transparent?: boolean;
              opacity?: number;
              depthWrite?: boolean;
              depthTest?: boolean;
              alphaTest?: number;
            };
            tintable.needsUpdate = true;
            tintable.side = THREE.FrontSide;
            tintable.transparent = false;
            tintable.opacity = 1;
            tintable.depthWrite = true;
            tintable.depthTest = true;
            tintable.alphaTest = 0;
            // The black route's hat stays the original asset white; all
            // others get tinted to the route's hatColor.
            if (hatColor.toLowerCase() !== "#ffffff") {
              tintable.color?.set(hatColor);
            }
            ownedMaterials.add(c);
            return c;
          };
          if (Array.isArray(mesh.material)) {
            mesh.material = mesh.material.map(cloneMat);
          } else {
            mesh.material = cloneMat(mesh.material);
          }
          mesh.renderOrder = 19;
          mesh.frustumCulled = false;
        });

        // Size the hat to ~45% of the train's footprint and perch it on
        // top of the train at z = train_max_z + small_gap. We work in
        // the train group's local coords (GLB-meters), so the per-frame
        // scale applied to the train group scales both train and hat
        // together — keeping their relative proportions constant.
        const hatBounds = new THREE.Box3().setFromObject(hatRoot);
        const hatSize = hatBounds.getSize(new THREE.Vector3());
        const hatFootprint = Math.max(hatSize.x, hatSize.y, 0.0001);
        const trainFootprint = Math.max(trainSize.x, trainSize.y, 0.0001);
        const hatScale = (trainFootprint * 0.45) / hatFootprint;
        hatRoot.scale.setScalar(hatScale);
        const trainTopZ = trainSize.z;
        hatRoot.position.set(0, 0, trainTopZ + trainSize.z * 0.02);

        return hatRoot;
      };

      const loadTrainModel = async () => {
        const loader = new GLTFLoader();
        const dracoLoader = new DRACOLoader();
        dracoLoader.setDecoderPath("/libs/draco/");
        loader.setDRACOLoader(dracoLoader);
        try {
          const gltf = await loader.loadAsync(trainModelUrl);
          if (disposed || !scene) {
            return;
          }
          const source = gltf.scene;

          // Build the train template ONCE (filter out the GLB's bundled
          // track meshes, normalize orientation, align long axis to +X),
          // then clone it per route and attach a tinted hat to each
          // clone. The template's geometry is shared across clones, but
          // each clone gets its own material instances so per-route
          // material tweaks (the hat tint specifically) don't bleed.
          const trainOnly = new THREE.Group();
          source.children.slice().forEach((child) => {
            const name = child.name.toLowerCase();
            const looksLikeTrack =
              name.includes("track") ||
              name.includes("rail") ||
              name.includes("sleeper") ||
              name.includes("tie");
            if (!looksLikeTrack) {
              trainOnly.add(child.clone(true));
            }
          });
          const templateModel =
            trainOnly.children.length > 0 ? trainOnly : source.clone(true);

          // Y-up GLB → Z-up world (same convention as the store & hat).
          templateModel.rotation.x = Math.PI / 2;

          templateModel.traverse((object) => {
            const mesh = object as THREE.Mesh;
            if (!mesh.isMesh) return;
            ownedGeometries.add(mesh.geometry);
            getMeshMaterials(mesh).forEach((material) => {
              const m = material as THREE.MeshStandardMaterial & {
                opacity?: number;
                transparent?: boolean;
                depthWrite?: boolean;
                depthTest?: boolean;
                alphaTest?: number;
              };
              m.needsUpdate = true;
              m.side = THREE.FrontSide;
              m.transparent = false;
              m.opacity = 1;
              m.depthWrite = true;
              m.depthTest = true;
              m.alphaTest = 0;
              ownedMaterials.add(material);
            });
            mesh.renderOrder = 18;
            mesh.frustumCulled = false;
          });

          templateModel.updateMatrixWorld(true);
          const bounds = new THREE.Box3().setFromObject(templateModel);
          const center = bounds.getCenter(new THREE.Vector3());
          templateModel.position.x -= center.x;
          templateModel.position.y -= center.y;
          templateModel.position.z -= bounds.min.z;

          const templateRoot = new THREE.Group();
          templateRoot.add(templateModel);
          templateRoot.updateMatrixWorld(true);

          // Long-axis alignment — see earlier comment.
          {
            const preAlignSize = new THREE.Box3()
              .setFromObject(templateRoot)
              .getSize(new THREE.Vector3());
            if (preAlignSize.y > preAlignSize.x) {
              templateRoot.rotation.z = -Math.PI / 2;
              templateRoot.updateMatrixWorld(true);
            }
          }

          const templateSize = new THREE.Box3()
            .setFromObject(templateRoot)
            .getSize(new THREE.Vector3());
          const footprint = Math.max(templateSize.x, templateSize.y, 0.0001);
          const baseFootprintScale = trainFootprintMeters / footprint;

          // Now build one clone per route, attach a tinted hat to each,
          // and seed the corresponding TrainState.
          ROUTE_IDS.forEach((id) => {
            const cfg = routeConfigs[id];
            const state = trains[id];
            const modelClone = templateRoot.clone(true);
            const group = new THREE.Group();
            group.add(modelClone);
            group.visible = false;

            if (normalizedHatTemplate) {
              const hat = buildTrainHat(
                normalizedHatTemplate,
                cfg.hatColor,
                templateSize,
              );
              group.add(hat);
              state.hatGroup = hat;
            }

            scene?.add(group);
            state.group = group;
            state.modelRoot = modelClone;
            state.baseFootprintScale = baseFootprintScale;

            // If `updateRailroadRoute` ran before the GLB finished
            // loading, the route data is already cached on the state.
            // Apply the pose now so the train shows up at the right
            // place on the very first render frame after load.
            if (state.routeActive) {
              applyTrainPose(state);
            }
          });

          mapInstance?.triggerRepaint();
        } catch (error) {
          console.warn("Unable to load H-E-B train model:", error);
        } finally {
          dracoLoader.dispose();
        }
      };

      const applyVisibility = (animateStateReveal = false) => {
        if (activeMode !== "state") {
          cancelStateMarkerReveal();
        }

        tileEntries.forEach((entry) => {
          const showStateMarker = activeMode === "state";
          entry.stateMarkerGroup.visible = showStateMarker;
          entry.modelGroup.visible =
            activeMode === "regional" &&
            (!activeRegionId || entry.regionId === activeRegionId);
          // Always set an explicit marker scale when toggling visibility.
          // Previously the "animating into state" branch left the scale
          // untouched and relied on the RAF tick to overwrite it on the
          // next frame. If anything cancelled the tick before all entries
          // reached progress=1, the scale could stick at a near-zero value
          // and the hat would look "gone" until the next state↔regional
          // toggle. Now: hidden → 0.001, animating → 0.001 (so the tick
          // tweens UP), resting → full scale. No mid-tween orphan state.
          if (!showStateMarker) {
            entry.stateMarkerModel.scale.setScalar(0.001);
          } else if (animateStateReveal) {
            entry.stateMarkerModel.scale.setScalar(0.001);
          } else {
            entry.stateMarkerModel.scale.setScalar(entry.stateMarkerScale);
          }
        });

        if (animateStateReveal) {
          animateStateMarkers();
        }
      };

      const animateStateMarkers = () => {
        cancelStateMarkerReveal();
        hasPlayedStateMarkerReveal = true;

        if (reduceMotion) {
          tileEntries.forEach((entry) => {
            entry.stateMarkerModel.scale.setScalar(entry.stateMarkerScale);
          });
          mapInstance?.triggerRepaint();
          return;
        }

        const start = performance.now();
        const duration = 720;
        const maxDelay = 780;
        const tick = (now: number) => {
          let isComplete = true;
          tileEntries.forEach((entry, index) => {
            const delay = Math.min(index * 5, maxDelay);
            const progress = Math.min(
              Math.max((now - start - delay) / duration, 0),
              1,
            );
            if (progress < 1) {
              isComplete = false;
            }

            const easedScale =
              entry.stateMarkerScale * easeStateMarkerPop(progress);
            entry.stateMarkerModel.scale.setScalar(Math.max(0.001, easedScale));
          });

          mapInstance?.triggerRepaint();
          if (!isComplete) {
            stateMarkerRevealFrame = window.requestAnimationFrame(tick);
          } else {
            tileEntries.forEach((entry) => {
              entry.stateMarkerModel.scale.setScalar(entry.stateMarkerScale);
            });
            stateMarkerRevealFrame = 0;
            mapInstance?.triggerRepaint();
          }
        };

        stateMarkerRevealFrame = window.requestAnimationFrame(tick);
      };

      const cancelStateMarkerReveal = () => {
        if (stateMarkerRevealFrame) {
          window.cancelAnimationFrame(stateMarkerRevealFrame);
          stateMarkerRevealFrame = 0;
        }
      };

      const easeStateMarkerPop = (progress: number) => {
        if (progress <= 0) {
          return 0.001;
        }
        if (progress >= 1) {
          return 1;
        }

        return (
          Math.pow(2, -10 * progress) *
            Math.sin((progress * 10 - 0.75) * ((2 * Math.PI) / 3)) +
          1
        );
      };

      const loadStoreModel = async () => {
        const loader = new GLTFLoader();
        const dracoLoader = new DRACOLoader();
        dracoLoader.setDecoderPath("/libs/draco/");
        loader.setDRACOLoader(dracoLoader);
        try {
          const [storeGltf, markerGltf] = await Promise.all([
            loader.loadAsync(storeModelUrl),
            loader.loadAsync(stateMarkerModelUrl),
          ]);

          if (disposed || !scene) {
            return;
          }

          const normalizedModel = normalizeStoreModel(
            storeGltf.scene,
            ownedGeometries,
            ownedMaterials,
          );
          const normalizedMarker = normalizeStateMarkerModel(
            markerGltf.scene,
            ownedGeometries,
            ownedMaterials,
          );
          // Publish the hat template to layer scope so `loadTrainModel`
          // can clone tinted copies for each route's train.
          normalizedHatTemplate = normalizedMarker;
          storeDefinitions.forEach((store) => {
            const storeBuild = createStoreModelGroup(store, normalizedModel);
            const stateMarker = createStateMarkerGroup(store, normalizedMarker);
            const entry: StoreTileEntry = {
              storeId: store.id,
              modelGroup: storeBuild.group,
              storeModel: storeBuild.model,
              baseModelScale: storeBuild.baseScale,
              stateMarkerGroup: stateMarker.group,
              stateMarkerModel: stateMarker.marker,
              stateMarkerScale: stateMarker.scale,
              regionId: store.regionId,
            };
            tileEntries.push(entry);
            tileEntriesById.set(store.id, entry);
            scene?.add(stateMarker.group);
            scene?.add(storeBuild.group);
            if (!loggedStoreModelBounds) {
              loggedStoreModelBounds = true;
              storeBuild.group.updateMatrixWorld(true);
              const bounds = new THREE.Box3().setFromObject(storeBuild.group);
              console.log("H-E-B store model world-space bounding box", {
                min: bounds.min.toArray(),
                max: bounds.max.toArray(),
              });
            }
          });
          applyVisibility(
            activeMode === "state" && !hasPlayedStateMarkerReveal,
          );
          mapInstance?.triggerRepaint();
        } catch (error) {
          console.warn("Unable to load H-E-B 3D marker models:", error);
        } finally {
          dracoLoader.dispose();
        }
      };

      const tweenStoreScale = (
        entry: StoreTileEntry,
        targetScale: number,
        durationMs: number,
        onComplete?: () => void,
      ) => {
        const proxy = { value: entry.storeModel.scale.x };
        const animation = animate(proxy, {
          value: targetScale,
          duration: reduceMotion ? 0 : durationMs,
          ease: "outQuad",
          onUpdate: () => {
            entry.storeModel.scale.setScalar(proxy.value);
            mapInstance?.triggerRepaint();
          },
          onComplete: () => {
            entry.storeModel.scale.setScalar(targetScale);
            mapInstance?.triggerRepaint();
            onComplete?.();
          },
        });
        return animation;
      };

      const setHoveredStore = (storeId: string | null) => {
        if (storeId === hoveredStoreId) {
          return;
        }
        const previousId = hoveredStoreId;
        hoveredStoreId = storeId;

        if (previousId) {
          const previousEntry = tileEntriesById.get(previousId);
          if (
            previousEntry &&
            previousEntry.modelGroup.visible &&
            !activePulseStoreIds.has(previousId)
          ) {
            tweenStoreScale(
              previousEntry,
              previousEntry.baseModelScale,
              hoverDurationMs,
            );
          }
        }

        if (storeId) {
          const entry = tileEntriesById.get(storeId);
          if (
            entry &&
            entry.modelGroup.visible &&
            !activePulseStoreIds.has(storeId)
          ) {
            tweenStoreScale(
              entry,
              entry.baseModelScale * hoverScaleFactor,
              hoverDurationMs,
            );
          }
        }
      };

      const pulseStore = (storeId: string) => {
        const entry = tileEntriesById.get(storeId);
        if (!entry || !entry.modelGroup.visible) {
          return;
        }

        activePulseStoreIds.add(storeId);
        tweenStoreScale(
          entry,
          entry.baseModelScale * pulseScaleFactor,
          Math.round(pulseDurationMs * 0.45),
          () => {
            const restingScale =
              hoveredStoreId === storeId
                ? entry.baseModelScale * hoverScaleFactor
                : entry.baseModelScale;
            tweenStoreScale(
              entry,
              restingScale,
              Math.round(pulseDurationMs * 0.55),
              () => {
                activePulseStoreIds.delete(storeId);
              },
            );
          },
        );
      };

      return {
        id: mapLayerIds.storeTiles,
        type: "custom",
        renderingMode: "3d",
        onAdd(mapArg, gl) {
          mapInstance = mapArg;
          camera = new THREE.Camera();
          scene = new THREE.Scene();
          scene.add(new THREE.HemisphereLight(0xffffff, 0xb9c3ca, 1.15));
          scene.add(new THREE.AmbientLight(0xffffff, 0.32));

          const keyLight = new THREE.DirectionalLight(0xffffff, 1.85);
          keyLight.position.set(-0.45, -0.8, 1.5);
          scene.add(keyLight);

          const fillLight = new THREE.DirectionalLight(0xfff0dc, 0.58);
          fillLight.position.set(0.9, 0.32, 0.72);
          scene.add(fillLight);

          const rimLight = new THREE.DirectionalLight(0xdcecff, 0.68);
          rimLight.position.set(0.12, 1.1, 1.2);
          scene.add(rimLight);

          renderer = new THREE.WebGLRenderer({
            canvas: mapArg.getCanvas(),
            context: gl,
            antialias: true,
          });
          renderer.autoClear = false;
          renderer.outputColorSpace = THREE.SRGBColorSpace;
          renderer.toneMapping = THREE.NeutralToneMapping;
          renderer.toneMappingExposure = 1.08;
          // Sequence: load the store + hat first so the cowboy-hat
          // template is populated, THEN load the train so it can clone
          // a tinted hat onto each per-route train. Without this order
          // the first train load would land before the template existed
          // and the trains would render hat-less.
          loadStoreModel()
            .then(() => {
              if (disposed) return;
              return loadTrainModel();
            })
            .catch((err) => {
              console.warn("Model load chain failed:", err);
            });
        },
        render(_gl, args) {
          const projectionMatrix = getProjectionMatrix(args);
          if (!scene || !camera || !renderer || !projectionMatrix) {
            return;
          }

          // Advance every route's train BEFORE drawing so all new poses
          // are what get rasterized this frame. Routes without an active
          // route short-circuit immediately and cost essentially nothing.
          tickTrains();

          camera.projectionMatrix.fromArray(projectionMatrix);
          renderer.resetState();
          renderer.render(scene, camera);
          mapInstance?.triggerRepaint();
        },
        onRemove() {
          disposed = true;
          cancelStateMarkerReveal();
          tileEntries.forEach((entry) => {
            scene?.remove(entry.modelGroup);
            scene?.remove(entry.stateMarkerGroup);
          });
          tileEntries.splice(0);
          ROUTE_IDS.forEach((id) => {
            const state = trains[id];
            if (state.group) {
              scene?.remove(state.group);
            }
            state.group = null;
            state.modelRoot = null;
            state.hatGroup = null;
            state.segments = [];
            state.stationDistances = [];
            state.totalLengthMeters = 0;
            state.progressMeters = 0;
            state.direction = 1;
            state.lastTickMs = 0;
            state.pauseEndsAt = 0;
            state.lastPausedStationIndex = -1;
            state.routeActive = false;
          });
          normalizedHatTemplate = null;
          ownedGeometries.forEach((geometry) => geometry.dispose());
          ownedGeometries.clear();
          ownedMaterials.forEach((material) => material.dispose());
          ownedMaterials.clear();
          renderer?.dispose();
          renderer = undefined;
          scene = undefined;
          camera = undefined;
          mapInstance = undefined;
        },
        setMode(mode, regionId) {
          const previousMode = activeMode;
          activeMode = mode;
          activeRegionId = regionId;
          if (mode === "hidden") {
            hasPlayedStateMarkerReveal = false;
          }
          if (mode !== "regional") {
            hoveredStoreId = null;
            activePulseStoreIds.clear();
            tileEntries.forEach((entry) => {
              entry.storeModel.scale.setScalar(entry.baseModelScale);
            });
          }
          const shouldAnimateStateReveal =
            mode === "state" &&
            previousMode !== "state" &&
            !hasPlayedStateMarkerReveal;
          applyVisibility(shouldAnimateStateReveal);
          // Belt-and-suspenders: if we're entering state mode WITHOUT the
          // pop animation (e.g. coming back from regional), force every
          // hat to its full resting scale right now. applyVisibility's
          // else branch already does this, but re-doing it here guards
          // against any future code path that might leave a hat at 0.001.
          if (mode === "state" && !shouldAnimateStateReveal) {
            tileEntries.forEach((entry) => {
              entry.stateMarkerModel.scale.setScalar(entry.stateMarkerScale);
            });
          }
          mapInstance?.triggerRepaint();
        },
        setHoveredStore,
        pulseStore,
        setRoute,
      };
    }

    // ────────────────────────────────────────────────────────────────────
    // ORIENTATION CONTROLS — flip these if the model still looks wrong.
    // The GLB is authored Y-up (verified: roofs at Y≈11.25, pillars at
    // Y≈2.1 in source node positions). Mapping Y-up to MapLibre's Z-up
    // world is a +π/2 rotation around X. If the model appears upside-down
    // in your browser, set MODEL_FLIP_UPSIDE_DOWN to true.
    const MODEL_FLIP_UPSIDE_DOWN = false; // try `true` if the building hangs from the sky
    // Distance (in GLB units) the H-E-B letters sit in front of the
    // white backdrop panel. The Center_Tower's front face is at GLB
    // z=+1.5, the backdrop at z=+1.55. With NUDGE=0.85 the letters sit
    // at z≈2.4 — comfortably in front of both, with no risk of clipping
    // into the tower's volume or z-fighting against the backdrop.
    const MODEL_LETTERS_NUDGE = 0.85;
    // The GLB stores the white backdrop panel at z=1.55 in source units.
    const HEB_BACKDROP_Z = 1.55;
    // ────────────────────────────────────────────────────────────────────

    function normalizeStoreModel(
      source: THREE.Object3D,
      ownedGeometries: Set<THREE.BufferGeometry>,
      ownedMaterials: Set<THREE.Material>,
    ) {
      const model = source.clone(true);

      // The GLB authors the H-E-B sign on the +Z side of the backdrop
      // panel, facing GLB +Z. With MapLibre's default camera, the user's
      // "front facing" view looks at this wall from a direction where
      // they see the back of the letters — which reads as mirrored
      // "B-E-H".
      //
      // Fix: flip the letters' X positions and rotate them 180° around
      // the vertical (Y) axis. The X-flip and Y-rotation together
      // produce the mirror image of the original glyph layout, so the
      // sign reads left-to-right as "H-E-B" from the user's camera.
      //
      // We KEEP the letters on the +Z (front) side of the backdrop,
      // pushed out by NUDGE so they sit clearly in front of the
      // Center_Tower's front face (z=+1.5) — no clipping into the
      // building wall, no z-fight against the backdrop.
      const yFlip = new THREE.Quaternion().setFromAxisAngle(
        new THREE.Vector3(0, 1, 0),
        Math.PI,
      );

      const flipSignToFrontWall = (name: string) => {
        const node = model.getObjectByName(name);
        if (!node) return;
        node.position.set(
          -node.position.x,
          node.position.y,
          HEB_BACKDROP_Z + MODEL_LETTERS_NUDGE,
        );
        // premultiply preserves any existing per-node rotation (e.g. the
        // B_white_space's built-in 90° X rotation) — the Y flip is
        // composed on top of it in world space.
        node.quaternion.premultiply(yFlip);
      };

      flipSignToFrontWall("HEB_Logo");
      flipSignToFrontWall("B_white_space");
      flipSignToFrontWall("B_white_space.001");

      // Y-up → Z-up.
      model.rotation.x = MODEL_FLIP_UPSIDE_DOWN ? -Math.PI / 2 : Math.PI / 2;

      model.traverse((object) => {
        const mesh = object as THREE.Mesh;
        if (!mesh.isMesh) {
          return;
        }

        ownedGeometries.add(mesh.geometry);
        const materials = getMeshMaterials(mesh);
        const hasRedMaterial = materials.some(isHebRedMaterial);

        materials.forEach((material) => {
          preserveGlbMaterialColor(material);
          ownedMaterials.add(material);
        });
        if (hasRedMaterial) {
          mesh.renderOrder = 20;
        }
        mesh.frustumCulled = false;
      });

      model.updateMatrixWorld(true);
      const initialBounds = new THREE.Box3().setFromObject(model);
      const center = initialBounds.getCenter(new THREE.Vector3());
      model.position.x -= center.x;
      model.position.y -= center.y;
      model.position.z -= initialBounds.min.z;

      const root = new THREE.Group();
      root.add(model);
      root.updateMatrixWorld(true);

      // One-time diagnostic so we can verify orientation from the browser
      // console without inspecting the canvas. Look at min.z and max.z:
      // min.z should be 0 (ground) and max.z should be the height of the
      // tallest part of the building (the tower roof).
      const finalBounds = new THREE.Box3().setFromObject(root);
      console.log("[HEB orientation check]", {
        flippedManually: MODEL_FLIP_UPSIDE_DOWN,
        rotationXRad: model.rotation.x,
        worldBoundsMin: finalBounds.min.toArray().map((n) => +n.toFixed(2)),
        worldBoundsMax: finalBounds.max.toArray().map((n) => +n.toFixed(2)),
        note: "max.z is the top of the model; if max.z is ~0 and min.z is negative, the model is upside-down — flip MODEL_FLIP_UPSIDE_DOWN.",
      });

      return {
        root,
        size: new THREE.Box3().setFromObject(root).getSize(new THREE.Vector3()),
      };
    }

    function getMeshMaterials(mesh: THREE.Mesh) {
      return Array.isArray(mesh.material) ? mesh.material : [mesh.material];
    }

    function isHebRedMaterial(material: THREE.Material) {
      return material.name.toLowerCase().includes("red");
    }

    function preserveGlbMaterialColor(material: THREE.Material) {
      material.needsUpdate = true;
      material.side = THREE.FrontSide;

      const possibleTexturedMaterial =
        material as THREE.MeshStandardMaterial & {
          map?: THREE.Texture | null;
          emissiveMap?: THREE.Texture | null;
          color?: THREE.Color;
          emissive?: THREE.Color;
          emissiveIntensity?: number;
          roughness?: number;
          metalness?: number;
          opacity?: number;
          transparent?: boolean;
          toneMapped?: boolean;
          depthWrite?: boolean;
          depthTest?: boolean;
          alphaTest?: number;
        };

      // Full opacity hardening — same as the cowboy hat + train. Pinning
      // depthWrite/depthTest/alphaTest stops any GLB-authored
      // alpha-cutoff or transparency-pass behavior from making the
      // building "flicker" or look semi-transparent against the map.
      // Previously only transparent/opacity were set; if a store-mesh's
      // texture carried an alpha channel the renderer would still
      // discard pixels via alphaTest, producing the unsteady look.
      possibleTexturedMaterial.transparent = false;
      possibleTexturedMaterial.opacity = 1;
      possibleTexturedMaterial.depthWrite = true;
      possibleTexturedMaterial.depthTest = true;
      possibleTexturedMaterial.alphaTest = 0;
      possibleTexturedMaterial.toneMapped = true;

      if (possibleTexturedMaterial.map) {
        possibleTexturedMaterial.map.colorSpace = THREE.SRGBColorSpace;
        possibleTexturedMaterial.map.needsUpdate = true;
      }

      if (possibleTexturedMaterial.emissiveMap) {
        possibleTexturedMaterial.emissiveMap.colorSpace = THREE.SRGBColorSpace;
        possibleTexturedMaterial.emissiveMap.needsUpdate = true;
      }

      if (isHebRedMaterial(material)) {
        possibleTexturedMaterial.color?.set(0xf31c24);
        possibleTexturedMaterial.emissive?.set(0xb20d14);
        possibleTexturedMaterial.emissiveIntensity = 0.82;
        possibleTexturedMaterial.roughness = 0.28;
        possibleTexturedMaterial.metalness = 0;
        possibleTexturedMaterial.toneMapped = false;
        // NOTE: We intentionally do NOT touch depthWrite / polygonOffset here.
        // The previous code disabled depthWrite and pulled the red faces
        // toward the camera with polygonOffset(-1,-1) so the H-E-B logo
        // would "pop", but that produced z-fighting between overlapping red
        // surfaces every frame (the "bleeding every second" symptom).
        // Standard depth writes + opaque rendering = stable image.
      }
    }

    function normalizeStateMarkerModel(
      source: THREE.Object3D,
      ownedGeometries: Set<THREE.BufferGeometry>,
      ownedMaterials: Set<THREE.Material>,
    ) {
      const model = source.clone(true);
      model.rotation.x = Math.PI / 2;
      model.traverse((object) => {
        const mesh = object as THREE.Mesh;
        if (!mesh.isMesh) {
          return;
        }

        ownedGeometries.add(mesh.geometry);
        getMeshMaterials(mesh).forEach((material) => {
          // Force the cowboy-hat materials to be FULLY OPAQUE and write to
          // the depth buffer. Without this, any material the GLB authored
          // with `alphaMode: BLEND` (or any texture with an alpha channel)
          // would have left `transparent = true` after loading. Three.js
          // renders transparent meshes in a separate, depth-sorted pass that
          // can flicker / drop frames depending on camera angle and other
          // transparent geometry on screen — which is exactly the "cowboy
          // hat sometimes disappears" symptom seen on the state view.
          // The store building's `preserveGlbMaterialColor` does the same
          // opacity hardening for the same reason.
          const m = material as THREE.MeshStandardMaterial & {
            opacity?: number;
            transparent?: boolean;
            depthWrite?: boolean;
            depthTest?: boolean;
            alphaTest?: number;
          };
          m.needsUpdate = true;
          m.side = THREE.FrontSide;
          m.transparent = false;
          m.opacity = 1;
          m.depthWrite = true;
          m.depthTest = true;
          m.alphaTest = 0;
          ownedMaterials.add(material);
        });
        mesh.renderOrder = 16;
        mesh.frustumCulled = false;
      });

      model.updateMatrixWorld(true);
      const initialBounds = new THREE.Box3().setFromObject(model);
      const center = initialBounds.getCenter(new THREE.Vector3());
      model.position.x -= center.x;
      model.position.y -= center.y;
      model.position.z -= initialBounds.min.z;

      const root = new THREE.Group();
      root.add(model);
      root.updateMatrixWorld(true);

      return {
        root,
        size: new THREE.Box3().setFromObject(root).getSize(new THREE.Vector3()),
      };
    }

    function createStoreModelGroup(
      store: StoreDefinition,
      normalizedModel: { root: THREE.Group; size: THREE.Vector3 },
    ) {
      const mercator = maplibregl.MercatorCoordinate.fromLngLat(
        [store.lng, store.lat],
        0,
      );
      const meterScale = mercator.meterInMercatorCoordinateUnits();
      const baseFootprintMeters = store.hub
        ? hubStoreFootprintMeters
        : regularStoreFootprintMeters;
      const regionMultiplier = computeStoreFootprintMultiplier(store);
      const targetFootprintMeters = baseFootprintMeters * regionMultiplier;
      const modelFootprint = Math.max(
        normalizedModel.size.x,
        normalizedModel.size.y,
        0.0001,
      );
      const modelScale = targetFootprintMeters / modelFootprint;
      const group = new THREE.Group();
      group.position.set(mercator.x, mercator.y, mercator.z);
      group.scale.set(meterScale, meterScale, meterScale);
      group.userData = {
        id: store.id,
        city: store.city,
        regionId: store.regionId,
      };

      const model = normalizedModel.root.clone(true);
      model.scale.setScalar(modelScale);
      group.userData.storeModel = model;
      group.add(model);

      return { group, model, baseScale: modelScale };
    }

    function createStateMarkerGroup(
      store: StoreDefinition,
      normalizedMarker: { root: THREE.Group; size: THREE.Vector3 },
    ) {
      const mercator = maplibregl.MercatorCoordinate.fromLngLat(
        [store.lng, store.lat],
        0,
      );
      const meterScale = mercator.meterInMercatorCoordinateUnits();
      const targetFootprintMeters = store.hub
        ? hubStateMarkerFootprintMeters
        : regularStateMarkerFootprintMeters;
      const markerFootprint = Math.max(
        normalizedMarker.size.x,
        normalizedMarker.size.y,
        0.0001,
      );
      const markerScale = targetFootprintMeters / markerFootprint;
      const group = new THREE.Group();
      group.position.set(mercator.x, mercator.y, mercator.z);
      group.scale.set(meterScale, meterScale, meterScale);
      group.userData = {
        id: store.id,
        city: store.city,
        regionId: store.regionId,
        stationMarker: true,
      };

      const marker = normalizedMarker.root.clone(true);
      marker.scale.setScalar(markerScale);
      marker.renderOrder = 16;
      group.add(marker);

      return { group, marker, scale: markerScale };
    }

    function getProjectionMatrix(args: unknown) {
      if (Array.isArray(args)) {
        return args as number[];
      }

      if (typeof args === "object" && args) {
        const mapArgs = args as {
          defaultProjectionData?: { mainMatrix?: number[] };
          projectionMatrix?: number[];
        };

        return (
          mapArgs.defaultProjectionData?.mainMatrix ?? mapArgs.projectionMatrix
        );
      }

      return undefined;
    }

    function createRegionDefinitions() {
      return texasRegionSpecs
        .map((spec) => {
          const svgPolygons = spec.clips
            .map((clip) =>
              prepareRegionPolygon(
                clipPolygonToConvexClip(texasOutlinePoints, clip),
                texasOutlinePoints,
              ),
            )
            .filter(
              (polygon) =>
                polygon.length >= 3 && Math.abs(signedSvgArea(polygon)) > 0.5,
            );

          const coordinates = svgPolygons.map((polygon) => [
            closeRing(polygon.map(svgPointToLngLat)),
          ]);
          const bounds = new maplibregl.LngLatBounds();
          coordinates.forEach((polygon) => {
            polygon[0].forEach((position) => bounds.extend(position));
          });

          return {
            id: spec.id,
            name: spec.name,
            svgPolygons,
            coordinates,
            bounds,
          } satisfies RegionDefinition;
        })
        .filter((region) => region.svgPolygons.length > 0);
    }

    function createStoreDefinitions() {
      return hebStores.map((store) => {
        const region = getRegionForSvgPoint({ x: store.x, y: store.y });
        return {
          ...store,
          regionId: region?.id ?? "statewide",
          regionName: region?.name ?? "Statewide",
        };
      });
    }

    function createRegionFeatureCollection(): MapFeatureCollection {
      return {
        type: "FeatureCollection",
        features: regionDefinitions.flatMap((region) =>
          region.coordinates.map((coordinates, index) => ({
            type: "Feature",
            id: `${region.id}-${index}`,
            properties: {
              regionId: region.id,
              regionName: region.name,
            },
            geometry: {
              type: "Polygon",
              coordinates,
            },
          })),
        ),
      };
    }

    function createStationFeatureCollection(): MapFeatureCollection {
      return {
        type: "FeatureCollection",
        features: storeDefinitions.map((store) => ({
          type: "Feature",
          id: store.id,
          properties: {
            id: store.id,
            name: `H-E-B ${store.city}`,
            address: store.address,
            city: store.city,
            zip: store.zip,
            regionId: store.regionId,
            regionName: store.regionName,
            hub: store.hub,
          },
          geometry: {
            type: "Polygon",
            coordinates: [createStationFootprint(store)],
          },
        })),
      };
    }

    function createEmptyFeatureCollection(): MapFeatureCollection {
      return {
        type: "FeatureCollection",
        features: [],
      };
    }

    function createStationFootprint(store: (typeof hebStores)[number]) {
      const halfMeters = store.hub ? 450 : 320;
      const latitudeRadians = (store.lat * Math.PI) / 180;
      const latOffset = halfMeters / 111_320;
      const lngOffset =
        halfMeters / (111_320 * Math.max(Math.cos(latitudeRadians), 0.12));

      return [
        [store.lng - lngOffset, store.lat - latOffset],
        [store.lng + lngOffset, store.lat - latOffset],
        [store.lng + lngOffset, store.lat + latOffset],
        [store.lng - lngOffset, store.lat + latOffset],
        [store.lng - lngOffset, store.lat - latOffset],
      ] as GeoJsonPosition[];
    }

    function handleIntroKeydown(event: KeyboardEvent) {
      if (event.key === "Enter" || event.key === " ") {
        revealStateNetwork(event);
      }
    }

    function revealStateNetwork(event?: MouseEvent | KeyboardEvent) {
      event?.preventDefault();
      event?.stopPropagation();

      if (!mapReady || viewState !== "landing" || isTransitioning) {
        return;
      }

      isTransitioning = true;
      returnViewState = "state-network";
      runIntroExit(() => {
        showStateNetwork(true);
        isTransitioning = false;
      });
    }

    function handleRegionMapClick(event: MapLayerMouseEvent) {
      if (!mapReady || isTransitioning || viewState !== "state-network") {
        return;
      }

      const regionId = event.features?.[0]?.properties?.regionId as
        | string
        | undefined;
      if (!regionId) {
        return;
      }

      enterRegionalView(regionId);
    }

    function handleStationMouseMove(event: MapLayerMouseEvent) {
      const stationId = event.features?.[0]?.properties?.id as
        | string
        | undefined;
      // Only react when the hovered building actually changes — `mousemove`
      // can fire dozens of times per second while the cursor sits on one
      // building. Idempotent calls into the layer would still cancel and
      // restart the anime.js tween every frame.
      if (!stationId || stationId === hoveredStationId) {
        return;
      }
      hoveredStationId = stationId;
      // Hover animation only makes sense when the regional store models are
      // actually on-screen. In state view the click target is a flat invisible
      // extrusion (no 3D building to scale), so we skip the call.
      if (viewState === "regional") {
        storeTileLayer?.setHoveredStore(stationId);
      }
    }

    function handleStationMapClick(event: MapLayerMouseEvent) {
      const station = event.features?.[0]?.properties;
      if (!station) {
        return;
      }

      const stationId = station.id as string | undefined;
      root.dataset.selectedStationId = String(stationId ?? "");
      root.dataset.selectedStationCity = String(station.city ?? "");

      // All adds/removes target the ACTIVE route. The active route is
      // the one whose accordion section is currently expanded, which is
      // also visually highlighted with that route's color. Switching the
      // active route happens via the accordion headers (see initRouteAccordion).
      if (viewState === "state-network" && !isTransitioning) {
        const regionId = station.regionId as string | undefined;
        if (regionId && regionId !== "statewide") {
          enterRegionalView(regionId, stationId);
        }
        if (stationId) {
          const selection = buildSelectionFromProperties(stationId, station);
          addSelectedStation(activeRouteId, selection);
          storeTileLayer?.pulseStore(stationId);
        }
        return;
      }

      // Regional-view click: TOGGLE within the active route. If the
      // station is already in THIS route, re-clicking removes it. A
      // station already in another route can still be added to the
      // active route — routes are independent.
      if (!stationId) {
        return;
      }
      storeTileLayer?.pulseStore(stationId);
      if (isStationSelected(activeRouteId, stationId)) {
        removeSelectedStation(activeRouteId, stationId);
      } else {
        const selection = buildSelectionFromProperties(stationId, station);
        addSelectedStation(activeRouteId, selection);
      }
    }

    function buildSelectionFromProperties(
      stationId: string,
      station: Record<string, unknown>,
    ): SelectedStation {
      return {
        id: stationId,
        name: String(station.name ?? `H-E-B ${station.city ?? ""}`),
        address: String(station.address ?? ""),
        city: String(station.city ?? ""),
        zip: String(station.zip ?? ""),
        regionId: String(station.regionId ?? ""),
        regionName: String(station.regionName ?? ""),
      };
    }

    function addSelectedStation(routeId: RouteId, selection: SelectedStation) {
      const stations = routeStations[routeId];
      if (stations.some((entry) => entry.id === selection.id)) {
        return;
      }
      stations.push(selection);
      renderSelectionListItem(routeId, selection);
      updateSelectionMeta();
      updateRailroadRoute(routeId);
      // Auto-expand this route's section so the user immediately sees
      // what they just selected. If it was already open we leave it
      // open. Clicking the header still toggles it shut afterward.
      setRouteOpen(routeId, true);
    }

    function removeSelectedStation(routeId: RouteId, stationId: string) {
      const stations = routeStations[routeId];
      const index = stations.findIndex((entry) => entry.id === stationId);
      if (index === -1) {
        return;
      }
      stations.splice(index, 1);
      // Update the railroad immediately so this route's track + train
      // respond to the removal in the same frame as the click; the
      // list-item collapse animation below is a DOM-level effect only.
      updateRailroadRoute(routeId);

      const list = root.querySelector<HTMLOListElement>(
        `[data-selection-list="${routeId}"]`,
      );
      const item = list?.querySelector<HTMLElement>(
        `[data-selection-item="${cssEscape(stationId)}"]`,
      );
      if (!item) {
        updateSelectionMeta();
        return;
      }

      // Lock the current height so the collapse-out animation has a
      // measurable starting point (the element's CSS resets height to auto
      // after the entrance animation completes).
      const currentHeight = item.offsetHeight;
      item.style.height = `${currentHeight}px`;
      item.style.overflow = "hidden";

      if (reduceMotion) {
        item.remove();
        updateSelectionMeta();
        return;
      }

      animate(item, {
        height: [currentHeight, 0],
        opacity: [1, 0],
        duration: 280,
        ease: "inCubic",
        onComplete: () => {
          item.remove();
          updateSelectionMeta();
        },
      });
    }

    function isStationSelected(routeId: RouteId, stationId: string) {
      return routeStations[routeId].some((entry) => entry.id === stationId);
    }

    // Older versions of Safari / WebKit lack CSS.escape, so we fall back to
    // a minimal escape for the characters that can appear in our store ids
    // (hyphens are fine in attribute selectors; only quote/backslash break).
    function cssEscape(value: string) {
      if (typeof CSS !== "undefined" && typeof CSS.escape === "function") {
        return CSS.escape(value);
      }
      return value.replace(/(["\\])/g, "\\$1");
    }

    // ─────────────────────────────────────────────────────────────────
    // Route ETA — "if this were a real Shinkansen, how long would the
    // traversal take?" Walks the polyline summing haversine distance,
    // adds a minute per intermediate stop for boarding/alighting, and
    // divides by an average Shinkansen cruise speed. Top-speed N700S
    // hits 320 km/h; average over a route with stops lands ~250 km/h.
    // ─────────────────────────────────────────────────────────────────
    const SHINKANSEN_AVG_KMH = 250;
    const STATION_STOP_MINUTES = 1;
    const EARTH_RADIUS_KM = 6371.0088;

    function haversineKm(
      lng1: number,
      lat1: number,
      lng2: number,
      lat2: number,
    ) {
      const toRad = (d: number) => (d * Math.PI) / 180;
      const dLat = toRad(lat2 - lat1);
      const dLng = toRad(lng2 - lng1);
      const phi1 = toRad(lat1);
      const phi2 = toRad(lat2);
      const sinDLat = Math.sin(dLat / 2);
      const sinDLng = Math.sin(dLng / 2);
      const a =
        sinDLat * sinDLat +
        Math.cos(phi1) * Math.cos(phi2) * sinDLng * sinDLng;
      return 2 * EARTH_RADIUS_KM * Math.asin(Math.min(1, Math.sqrt(a)));
    }

    function formatRouteMinutes(totalMinutes: number) {
      if (totalMinutes < 1) return "<1 min";
      if (totalMinutes < 60) return `${Math.round(totalMinutes)} min`;
      const hours = Math.floor(totalMinutes / 60);
      const minutes = Math.round(totalMinutes % 60);
      return minutes === 0 ? `${hours}h` : `${hours}h ${minutes}m`;
    }

    function estimateRouteEta(routeId: RouteId): string | null {
      const stations = routeStations[routeId];
      if (stations.length < 2) return null;
      let totalKm = 0;
      for (let i = 0; i < stations.length - 1; i += 1) {
        const a = storeDefinitions.find((s) => s.id === stations[i].id);
        const b = storeDefinitions.find((s) => s.id === stations[i + 1].id);
        if (a && b) {
          totalKm += haversineKm(a.lng, a.lat, b.lng, b.lat);
        }
      }
      const travelMinutes = (totalKm / SHINKANSEN_AVG_KMH) * 60;
      const stopMinutes =
        Math.max(0, stations.length - 2) * STATION_STOP_MINUTES;
      return formatRouteMinutes(travelMinutes + stopMinutes);
    }

    function renderSelectionListItem(
      routeId: RouteId,
      selection: SelectedStation,
    ) {
      const list = root.querySelector<HTMLOListElement>(
        `[data-selection-list="${routeId}"]`,
      );
      if (!list) return;

      const item = document.createElement("li");
      item.className = "heb-landing__selection-item";
      item.dataset.selectionItem = selection.id;

      const body = document.createElement("div");
      body.className = "heb-landing__selection-item-body";

      const name = document.createElement("p");
      name.className = "heb-landing__selection-item-name";
      name.textContent = selection.name;

      const address = document.createElement("p");
      address.className = "heb-landing__selection-item-address";
      address.textContent = [selection.address, selection.city, selection.zip]
        .filter(Boolean)
        .join(", ");

      const region = document.createElement("p");
      region.className = "heb-landing__selection-item-region";
      region.textContent = selection.regionName;

      body.append(name, address, region);

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "heb-landing__selection-item-remove";
      remove.setAttribute("aria-label", `Remove ${selection.name}`);
      remove.dataset.removeId = selection.id;
      const removeIcon = document.createElement("span");
      removeIcon.setAttribute("aria-hidden", "true");
      removeIcon.textContent = "×";
      remove.appendChild(removeIcon);
      remove.addEventListener("click", (event) => {
        event.stopPropagation();
        removeSelectedStation(routeId, selection.id);
      });

      item.append(body, remove);
      list.appendChild(item);
      animateSelectionItemIn(item);
    }

    function animateSelectionItemIn(item: HTMLElement) {
      // Measure natural height by temporarily letting the item lay out at its
      // intrinsic size. The element is collapsed (height: 0) by CSS so we
      // can't just read offsetHeight directly. We force a measurement frame
      // with height: auto + visibility: hidden, capture the height, then
      // restore the collapsed start state for anime.js to interpolate from.
      item.style.height = "auto";
      item.style.opacity = "0";
      const naturalHeight = item.offsetHeight;
      item.style.height = "0px";

      if (reduceMotion) {
        item.style.height = "auto";
        item.style.opacity = "1";
        // Scroll the new entry into view inside the panel so users on
        // reduced-motion still see what was added.
        selectionPanel.scrollTo({
          top: selectionPanel.scrollHeight,
          behavior: "auto",
        });
        return;
      }

      animate(item, {
        height: [0, naturalHeight],
        opacity: [0, 1],
        duration: 420,
        ease: "outCubic",
        onComplete: () => {
          // Release the explicit height so future content / responsive
          // reflow can adjust the row's height naturally.
          item.style.height = "auto";
        },
      });

      // Auto-scroll the panel so newly-appended items remain visible even
      // after the list grows past the viewport height.
      selectionPanel.scrollTo({
        top: selectionPanel.scrollHeight,
        behavior: "smooth",
      });
    }

    function updateSelectionMeta() {
      let total = 0;
      ROUTE_IDS.forEach((id) => {
        const count = routeStations[id].length;
        total += count;
        const countEl = root.querySelector<HTMLElement>(
          `[data-route-count="${id}"]`,
        );
        if (countEl) {
          countEl.textContent = String(count);
        }
        const empty = root.querySelector<HTMLElement>(
          `[data-selection-empty="${id}"]`,
        );
        if (empty) {
          empty.hidden = count > 0;
        }
        // Recompute the Shinkansen ETA for this route. Empty string
        // when fewer than 2 stations are selected — the `:empty` CSS
        // rule then hides the pill so it doesn't render as a stray
        // dot in the header.
        const etaEl = root.querySelector<HTMLElement>(
          `[data-route-eta="${id}"]`,
        );
        if (etaEl) {
          etaEl.textContent = estimateRouteEta(id) ?? "";
        }
      });
      selectionCount.textContent = `${total} ${total === 1 ? "station" : "stations"}`;
    }

    // ────────────────────────────────────────────────────────────────
    // Per-route railroad updater.
    //
    // Called by every mutation point on routeStations[routeId]. Updates
    // ONE route's MapLibre source + Three.js train (or all routes when
    // called without an argument — used by `clearSelectedStations` and
    // initial setup). Each route owns its own GeoJSON source + colored
    // line layer; routes are independent and all visible at once.
    // ────────────────────────────────────────────────────────────────
    function updateRailroadRoute(routeId?: RouteId) {
      if (!map) {
        return;
      }
      const ids: RouteId[] = routeId ? [routeId] : ROUTE_IDS;
      ids.forEach((id) => {
        const sourceId = railroadSourceIdFor(id);
        const source = map?.getSource(sourceId) as
          | maplibregl.GeoJSONSource
          | undefined;
        const stations = routeStations[id];

        if (stations.length < 2) {
          source?.setData(createEmptyFeatureCollection() as never);
          storeTileLayer?.setRoute(id, null);
          return;
        }

        const coordinates: GeoJsonPosition[] = [];
        stations.forEach((selected) => {
          const def = storeDefinitions.find((store) => store.id === selected.id);
          if (def) {
            coordinates.push([def.lng, def.lat]);
          }
        });

        if (coordinates.length < 2) {
          source?.setData(createEmptyFeatureCollection() as never);
          storeTileLayer?.setRoute(id, null);
          return;
        }

        const lineFeature: MapFeatureCollection = {
          type: "FeatureCollection",
          features: [
            {
              type: "Feature",
              id: `active-railroad-${id}`,
              properties: {
                routeId: id,
                stationCount: coordinates.length,
              },
              geometry: {
                type: "LineString",
                coordinates,
              },
            },
          ],
        };
        source?.setData(lineFeature as never);
        storeTileLayer?.setRoute(id, coordinates);
      });
    }

    function clearSelectedStations() {
      ROUTE_IDS.forEach((id) => {
        routeStations[id].length = 0;
        const list = root.querySelector<HTMLOListElement>(
          `[data-selection-list="${id}"]`,
        );
        list?.replaceChildren();
      });
      updateSelectionMeta();
      updateRailroadRoute();
    }

    function setSelectionPanelVisible(isVisible: boolean) {
      selectionPanel.hidden = !isVisible;
    }

    function enterRegionalView(regionId: string, preferredStoreId?: string) {
      const region = regionDefinitions.find((item) => item.id === regionId);
      if (!map || !region || isTransitioning) {
        return;
      }

      isTransitioning = true;
      returnViewState =
        viewState === "state-network" ? "state-network" : "landing";
      viewState = "regional";
      currentRegionId = regionId;
      root.dataset.viewState = "regional";
      root.dataset.regionalView = "true";
      regionHud.hidden = false;
      regionTitle.textContent = `${region.name.toUpperCase()} REGIONAL NETWORK`;
      regionTitlePanel.style.opacity = "0";
      regionReturn.style.opacity = "0";
      setStationLayerMode("hidden");
      // Surface the traversal panel for the duration of the regional view.
      // updateSelectionMeta keeps the count + empty-state placeholder in
      // sync with the (possibly-preserved) array on re-entry.
      setSelectionPanelVisible(true);
      updateSelectionMeta();

      runIntroExit();
      animate(regionTitlePanel, {
        opacity: [0, 1],
        duration: 320,
        ease: "outCubic",
      });
      animate(regionReturn, {
        opacity: [0, 1],
        duration: 320,
        ease: "outCubic",
      });

      const cameraTarget = getRegionalCameraTarget(region, preferredStoreId);
      root.dataset.regionalAnchorStoreId = cameraTarget.anchorStore?.id ?? "";
      root.dataset.regionalAnchorStoreCity =
        cameraTarget.anchorStore?.city ?? "";
      const duration = reduceMotion ? 0 : 980;
      // (1) Lock gesture handlers so any wheel events that arrive after
      // the click are ignored (prevents new animations from starting).
      lockMapInteractions();
      // (2) Cancel any animation currently in flight. This is critical
      // for the wheel-then-click sequence: MapLibre's scrollZoom kicks
      // off its OWN internal camera animation (the smooth inertia ease)
      // that runs for ~150-300ms after the wheel stops. Disabling the
      // handler only stops FUTURE wheel events from triggering more
      // animations — the one already in flight keeps going until it
      // ends naturally OR until we cancel it here. Without map.stop(),
      // the leftover inertia hits its next render tick and clobbers
      // the flyTo mid-trajectory — exactly the "fly-in cuts off in the
      // middle" symptom that appears when you wheel-zoom in then out
      // rapidly before clicking.
      map.stop();
      completeAfterMove(duration, () => {
        unlockMapInteractions();
        if (currentRegionId !== regionId) {
          return;
        }

        setStationLayerMode("regional", regionId);
        syncLodFromZoom();
        isTransitioning = false;
      });
      // (3) Start the scripted fly on a clean slate.
      map.flyTo({
        center: cameraTarget.center,
        zoom: cameraTarget.zoom,
        pitch: regionalPitch,
        bearing: regionalBearing,
        duration,
        curve: 1.42,
        speed: 0.72,
        essential: true,
      } as maplibregl.FlyToOptions);
    }

    function returnToStateView() {
      if (!map || isTransitioning || viewState !== "regional") {
        return;
      }

      isTransitioning = true;
      const targetState = returnViewState;
      currentRegionId = null;
      animate(regionTitlePanel, {
        opacity: 0,
        duration: 220,
        ease: "outCubic",
      });
      animate(regionReturn, { opacity: 0, duration: 220, ease: "outCubic" });
      setStationLayerMode(targetState === "state-network" ? "state" : "hidden");

      const duration = reduceMotion ? 0 : 860;
      lockMapInteractions();
      map.stop();
      completeAfterMove(duration, () => {
        unlockMapInteractions();
        if (targetState === "state-network") {
          showStateNetwork(false);
        } else {
          showLanding(false);
        }
        isTransitioning = false;
      });
      map.flyTo({
        center: texasBounds.getCenter(),
        zoom: mapStateZoom,
        pitch: mapPitch,
        bearing: stateBearing,
        duration,
        curve: 1.34,
        speed: 0.84,
        essential: true,
      } as maplibregl.FlyToOptions);
    }

    function showLanding(fitCamera = true) {
      viewState = "landing";
      currentRegionId = null;
      returnViewState = "landing";
      root.dataset.viewState = "landing";
      root.dataset.regionalView = "false";
      root.dataset.maplibreLod = "state";
      regionHud.hidden = true;
      regionTitlePanel.style.opacity = "0";
      regionReturn.style.opacity = "0";
      introCopy.style.opacity = "1";
      introCopy.style.transform = "scale(1)";
      introCopy.style.visibility = "visible";
      setStationLayerMode("hidden");
      setRouteLayerVisible(false);
      // Landing is the "start over" state — the user is no longer mid-traversal
      // so the selection list resets. Panels in non-regional views stay hidden.
      setSelectionPanelVisible(false);
      clearSelectedStations();

      if (fitCamera) {
        fitTexas(0);
      }
    }

    function showStateNetwork(fitCamera = true) {
      viewState = "state-network";
      currentRegionId = null;
      returnViewState = "state-network";
      root.dataset.viewState = "state-network";
      root.dataset.regionalView = "false";
      regionHud.hidden = true;
      regionTitlePanel.style.opacity = "0";
      regionReturn.style.opacity = "0";
      introCopy.style.opacity = "0";
      introCopy.style.transform = "scale(0.88)";
      introCopy.style.visibility = "hidden";
      setStationLayerMode("state");
      setRouteLayerVisible(false);
      // Hide the panel while at the state-network view — the panel is the
      // "regional traversal" log. Selections remain in memory so returning
      // to regional view shows the same list (no surprise erasure).
      setSelectionPanelVisible(false);
      syncLodFromZoom();

      if (fitCamera) {
        fitTexas(reduceMotion ? 0 : 680);
      }
    }

    function fitTexas(duration: number) {
      map?.flyTo({
        center: texasBounds.getCenter(),
        zoom: mapStateZoom,
        pitch: mapPitch,
        bearing: stateBearing,
        duration,
        curve: 1.34,
        speed: 0.84,
        essential: true,
      } as maplibregl.FlyToOptions);
    }

    function runIntroExit(onComplete?: () => void) {
      if (
        introCopy.style.visibility === "hidden" ||
        introCopy.style.opacity === "0" ||
        reduceMotion
      ) {
        introCopy.style.opacity = "0";
        introCopy.style.transform = "scale(0.88)";
        introCopy.style.visibility = "hidden";
        onComplete?.();
        return;
      }

      createTimeline({
        onComplete: () => {
          introCopy.style.visibility = "hidden";
          onComplete?.();
        },
      }).add(
        introCopy,
        {
          opacity: [1, 0],
          scale: [1, 0.88],
          duration: 360,
          ease: "inCubic",
        },
        0,
      );
    }

    function lockMapInteractions() {
      if (!map) return;
      // Disable every gesture-driven camera handler. The big one is
      // scrollZoom — if the user wheel-scrolls during our flyTo (or has
      // residual wheel-input still in flight from before the click),
      // MapLibre's scrollZoom handler starts a new ease that cancels
      // the flyTo. Disabling all of them keeps the scripted animation
      // running cleanly. They're re-enabled when the flyTo completes.
      map.scrollZoom.disable();
      map.boxZoom.disable();
      map.dragRotate.disable();
      map.dragPan.disable();
      map.keyboard.disable();
      map.doubleClickZoom.disable();
      map.touchZoomRotate.disable();
    }

    function unlockMapInteractions() {
      if (!map) return;
      map.scrollZoom.enable();
      map.boxZoom.enable();
      map.dragRotate.enable();
      map.dragPan.enable();
      map.keyboard.enable();
      map.doubleClickZoom.enable();
      map.touchZoomRotate.enable();
    }

    function completeAfterMove(duration: number, callback: () => void) {
      let completed = false;
      const finish = () => {
        if (completed) {
          return;
        }

        completed = true;
        callback();
      };

      window.setTimeout(finish, duration + 140);
    }

    function setStationLayerMode(mode: StationMode, regionId?: string) {
      if (!map?.getLayer(mapLayerIds.stations)) {
        storeTileLayer?.setMode(mode, regionId);
        return;
      }

      if (regionId) {
        map.setFilter(mapLayerIds.stations, [
          "==",
          ["get", "regionId"],
          regionId,
        ]);
      } else {
        map.setFilter(mapLayerIds.stations, null);
      }

      if (mode === "hidden") {
        map.setPaintProperty(mapLayerIds.stations, "fill-extrusion-opacity", 0);
        storeTileLayer?.setMode(mode, regionId);
        return;
      }

      map.setPaintProperty(mapLayerIds.stations, "fill-extrusion-opacity", 0);
      storeTileLayer?.setMode(mode, regionId);
    }

    function setRouteLayerVisible(isVisible: boolean) {
      if (map?.getLayer(mapLayerIds.routes)) {
        map.setPaintProperty(
          mapLayerIds.routes,
          "line-opacity",
          isVisible ? 0.9 : 0,
        );
      }
    }

    function syncLodFromZoom() {
      if (!map) {
        return;
      }

      const lod =
        map.getZoom() >= 7.25 || viewState === "regional"
          ? "regional"
          : "state";
      root.dataset.maplibreLod = lod;
    }

    function getStateFitPadding() {
      const verticalPadding = Math.max(86, window.innerHeight * 0.12);
      const horizontalPadding = Math.max(44, window.innerWidth * 0.12);
      return {
        top: verticalPadding,
        bottom: verticalPadding,
        left: horizontalPadding,
        right: horizontalPadding,
      };
    }

    function getRegionalFitPadding() {
      return {
        top: Math.max(86, window.innerHeight * 0.12),
        bottom: Math.max(96, window.innerHeight * 0.16),
        left: Math.max(54, window.innerWidth * 0.1),
        right: Math.max(54, window.innerWidth * 0.1),
      };
    }

    function getRegionalCameraTarget(
      region: RegionDefinition,
      preferredStoreId?: string,
    ) {
      const anchorStore = getRegionalAnchorStore(region, preferredStoreId);
      const center = anchorStore
        ? new maplibregl.LngLat(anchorStore.lng, anchorStore.lat)
        : region.bounds.getCenter();

      return {
        anchorStore,
        center,
        zoom: getRegionalAnchorZoom(region, Boolean(anchorStore)),
      };
    }

    function getRegionalAnchorStore(
      region: RegionDefinition,
      preferredStoreId?: string,
    ) {
      const preferredStore = preferredStoreId
        ? storeDefinitions.find(
            (store) =>
              store.id === preferredStoreId && store.regionId === region.id,
          )
        : undefined;
      if (preferredStore) {
        return preferredStore;
      }

      const anchorId = regionalAnchorStoreIds[region.id];
      const explicitAnchor = anchorId
        ? storeDefinitions.find((store) => store.id === anchorId)
        : undefined;
      if (explicitAnchor) {
        return explicitAnchor;
      }

      const regionStores = storeDefinitions.filter(
        (store) => store.regionId === region.id,
      );
      if (regionStores.length) {
        return getClosestStoreToLngLat(regionStores, region.bounds.getCenter());
      }

      return getClosestStoreToLngLat(
        storeDefinitions,
        region.bounds.getCenter(),
      );
    }

    function getClosestStoreToLngLat(
      stores: StoreDefinition[],
      target: maplibregl.LngLat,
    ) {
      return stores.reduce<StoreDefinition | undefined>((closest, store) => {
        if (!closest) {
          return store;
        }

        return getLngLatDistanceScore(store, target) <
          getLngLatDistanceScore(closest, target)
          ? store
          : closest;
      }, undefined);
    }

    function getLngLatDistanceScore(
      store: StoreDefinition,
      target: maplibregl.LngLat,
    ) {
      const lngDelta = store.lng - target.lng;
      const latDelta = store.lat - target.lat;
      return lngDelta * lngDelta + latDelta * latDelta;
    }

    function getRegionalAnchorZoom(
      region: RegionDefinition,
      hasAnchorStore: boolean,
    ) {
      // Always fly to a CONSISTENT zoom level when a region is clicked,
      // independent of the user's current zoom.
      //
      // The previous version added a relative step on top of the user's
      // current zoom (`currentZoom + manualZoomStep`). That meant: if a
      // user wheel-zoomed in past the regional anchor zoom and then
      // clicked a region, the fly-in target collapsed toward "wherever
      // they already are" — no cinematic fly-in to the designated HEB,
      // just a small camera nudge that ended with the regional building
      // models popping in (the "just display the stores" symptom).
      //
      // With a fixed target, every click — regardless of prior wheel
      // zoom — produces a deliberate, predictable fly-in that lands the
      // camera exactly on the designated HEB at the right framing.
      const baseline = hasAnchorStore
        ? Math.max(mapRegionalAnchorZoom, getRegionalMaxZoom(region))
        : getRegionalMaxZoom(region);
      const mapMaxZoom = map?.getMaxZoom() ?? 22;
      return Math.min(mapMaxZoom - 0.05, baseline);
    }

    function getRegionalMaxZoom(region: RegionDefinition) {
      const west = region.bounds.getWest();
      const east = region.bounds.getEast();
      const north = region.bounds.getNorth();
      const south = region.bounds.getSouth();
      const span = Math.max(
        Math.abs(east - west),
        Math.abs(north - south),
        0.08,
      );
      return Math.min(11.2, Math.max(mapRegionalZoom, 10.9 - Math.log2(span)));
    }

    function getFeatureCollectionBounds(collection: MapFeatureCollection) {
      const bounds = new maplibregl.LngLatBounds();
      collection.features.forEach((feature) => {
        if (feature.geometry.type === "Polygon") {
          feature.geometry.coordinates
            .flat()
            .forEach((position) => bounds.extend(position));
        } else {
          feature.geometry.coordinates.forEach((position) =>
            bounds.extend(position),
          );
        }
      });

      return bounds.isEmpty()
        ? new maplibregl.LngLatBounds([-106.7, 25.7], [-93.4, 36.5])
        : bounds;
    }

    function getRegionForSvgPoint(point: SvgPoint) {
      return regionDefinitions.find((region) =>
        region.svgPolygons.some((polygon) =>
          isPointInSvgPolygon(point, polygon),
        ),
      );
    }

    function isPointInSvgPolygon(point: SvgPoint, polygon: SvgPoint[]) {
      let inside = false;

      for (
        let index = 0, previousIndex = polygon.length - 1;
        index < polygon.length;
        previousIndex = index, index += 1
      ) {
        const current = polygon[index];
        const previous = polygon[previousIndex];
        const intersects =
          current.y > point.y !== previous.y > point.y &&
          point.x <
            ((previous.x - current.x) * (point.y - current.y)) /
              (previous.y - current.y || 0.000001) +
              current.x;

        if (intersects) {
          inside = !inside;
        }
      }

      return inside;
    }

    function parseSvgPathPoints(pathData: string) {
      const tokens = pathData.match(/[MLZ]|-?\d+(?:\.\d+)?/g) ?? [];
      const points: SvgPoint[] = [];
      let index = 0;
      let command = "";

      while (index < tokens.length) {
        const token = tokens[index++];
        if (token === "M" || token === "L" || token === "Z") {
          command = token;
        } else {
          index -= 1;
        }

        if (command === "M" || command === "L") {
          const x = Number(tokens[index++]);
          const y = Number(tokens[index++]);
          points.push({ x, y });
        }

        if (command === "Z") {
          break;
        }
      }

      return cleanSvgPolygon(points);
    }

    function prepareRegionPolygon(
      points: SvgPoint[],
      texasOutline: SvgPoint[],
    ) {
      return normalizeSvgPolygon(
        snapPolygonToMasterBoundary(cleanSvgPolygon(points), texasOutline),
      );
    }

    function snapPolygonToMasterBoundary(
      points: SvgPoint[],
      texasOutline: SvgPoint[],
    ) {
      return points.map((point) =>
        snapPointToMasterBoundary(point, texasOutline),
      );
    }

    function snapPointToMasterBoundary(
      point: SvgPoint,
      texasOutline: SvgPoint[],
    ) {
      let nearestPoint = point;
      let nearestDistance = Number.POSITIVE_INFINITY;
      const snapTolerance = 0.08;

      for (let index = 0; index < texasOutline.length; index += 1) {
        const start = texasOutline[index];
        const end = texasOutline[(index + 1) % texasOutline.length];
        const candidate = closestPointOnSegment(point, start, end);
        const distance = Math.hypot(
          point.x - candidate.x,
          point.y - candidate.y,
        );

        if (distance < nearestDistance) {
          nearestDistance = distance;
          nearestPoint = candidate;
        }
      }

      return nearestDistance <= snapTolerance ? nearestPoint : point;
    }

    function closestPointOnSegment(
      point: SvgPoint,
      start: SvgPoint,
      end: SvgPoint,
    ) {
      const segmentX = end.x - start.x;
      const segmentY = end.y - start.y;
      const lengthSquared = segmentX * segmentX + segmentY * segmentY;

      if (lengthSquared === 0) {
        return start;
      }

      const t = Math.max(
        0,
        Math.min(
          1,
          ((point.x - start.x) * segmentX + (point.y - start.y) * segmentY) /
            lengthSquared,
        ),
      );
      return {
        x: start.x + t * segmentX,
        y: start.y + t * segmentY,
      };
    }

    function normalizeSvgPolygon(points: SvgPoint[]) {
      return cleanSvgPolygon(
        points.map((point) => ({
          x: snapNumber(point.x),
          y: snapNumber(point.y),
        })),
      );
    }

    function snapNumber(value: number) {
      return Math.round(value / svgSnapPrecision) * svgSnapPrecision;
    }

    function clipPolygonToConvexClip(
      subjectPolygon: SvgPoint[],
      clipPolygon: SvgPoint[],
    ) {
      let output = [...subjectPolygon];
      const clipOrientation = signedSvgArea(clipPolygon) >= 0 ? 1 : -1;

      for (let clipIndex = 0; clipIndex < clipPolygon.length; clipIndex += 1) {
        const clipStart = clipPolygon[clipIndex];
        const clipEnd = clipPolygon[(clipIndex + 1) % clipPolygon.length];
        const input = output;
        output = [];

        for (let index = 0; index < input.length; index += 1) {
          const start = input[(index + input.length - 1) % input.length];
          const end = input[index];
          const startInside = isInsideClipEdge(
            start,
            clipStart,
            clipEnd,
            clipOrientation,
          );
          const endInside = isInsideClipEdge(
            end,
            clipStart,
            clipEnd,
            clipOrientation,
          );

          if (endInside) {
            if (!startInside) {
              output.push(
                getSegmentIntersection(start, end, clipStart, clipEnd),
              );
            }
            output.push(end);
          } else if (startInside) {
            output.push(getSegmentIntersection(start, end, clipStart, clipEnd));
          }
        }

        output = cleanSvgPolygon(output);
      }

      return output;
    }

    function isInsideClipEdge(
      point: SvgPoint,
      edgeStart: SvgPoint,
      edgeEnd: SvgPoint,
      clipOrientation: number,
    ) {
      const cross =
        (edgeEnd.x - edgeStart.x) * (point.y - edgeStart.y) -
        (edgeEnd.y - edgeStart.y) * (point.x - edgeStart.x);

      return clipOrientation >= 0 ? cross >= -0.001 : cross <= 0.001;
    }

    function getSegmentIntersection(
      start: SvgPoint,
      end: SvgPoint,
      edgeStart: SvgPoint,
      edgeEnd: SvgPoint,
    ) {
      const segmentX = end.x - start.x;
      const segmentY = end.y - start.y;
      const edgeX = edgeEnd.x - edgeStart.x;
      const edgeY = edgeEnd.y - edgeStart.y;
      const denominator = segmentX * edgeY - segmentY * edgeX;

      if (Math.abs(denominator) < 0.000001) {
        return { ...end };
      }

      const t =
        ((edgeStart.x - start.x) * edgeY - (edgeStart.y - start.y) * edgeX) /
        denominator;
      return {
        x: start.x + t * segmentX,
        y: start.y + t * segmentY,
      };
    }

    function cleanSvgPolygon(points: SvgPoint[]) {
      const cleaned: SvgPoint[] = [];

      for (const point of points) {
        const previous = cleaned[cleaned.length - 1];
        if (
          !previous ||
          Math.hypot(previous.x - point.x, previous.y - point.y) > 0.001
        ) {
          cleaned.push(point);
        }
      }

      const first = cleaned[0];
      const last = cleaned[cleaned.length - 1];
      if (
        first &&
        last &&
        Math.hypot(first.x - last.x, first.y - last.y) <= 0.001
      ) {
        cleaned.pop();
      }

      return cleaned;
    }

    function signedSvgArea(points: SvgPoint[]) {
      let area = 0;

      for (let index = 0; index < points.length; index += 1) {
        const current = points[index];
        const next = points[(index + 1) % points.length];
        area += current.x * next.y - next.x * current.y;
      }

      return area / 2;
    }

    function getSvgPointBounds(points: SvgPoint[]): SvgBounds {
      const bounds = {
        minX: Number.POSITIVE_INFINITY,
        maxX: Number.NEGATIVE_INFINITY,
        minY: Number.POSITIVE_INFINITY,
        maxY: Number.NEGATIVE_INFINITY,
      };

      points.forEach((point) => {
        bounds.minX = Math.min(bounds.minX, point.x);
        bounds.maxX = Math.max(bounds.maxX, point.x);
        bounds.minY = Math.min(bounds.minY, point.y);
        bounds.maxY = Math.max(bounds.maxY, point.y);
      });

      if (!Number.isFinite(bounds.minX) || !Number.isFinite(bounds.minY)) {
        return { minX: 0, maxX: 512, minY: 0, maxY: 512 };
      }

      return bounds;
    }

    function createGlobalMercatorFrame(
      stores: typeof hebStores,
      svgBounds: SvgBounds,
    ): GlobalMercatorFrame {
      const longitudePairs: [number, number][] = [];
      const latitudePairs: [number, number][] = [];
      const svgWidth = Math.max(svgBounds.maxX - svgBounds.minX, 0.000001);
      const svgHeight = Math.max(svgBounds.maxY - svgBounds.minY, 0.000001);

      stores.forEach((store) => {
        const projected = projectWebMercator(store.lat, store.lng);
        longitudePairs.push([
          (store.x - svgBounds.minX) / svgWidth,
          projected.x,
        ]);
        latitudePairs.push([
          (svgBounds.maxY - store.y) / svgHeight,
          projected.y,
        ]);
      });

      const projectedXFrame = fitProjectionFrame(longitudePairs);
      const projectedYFrame = fitProjectionFrame(latitudePairs);

      return {
        svgBounds,
        projectedMin: { x: projectedXFrame.min, y: projectedYFrame.min },
        projectedMax: { x: projectedXFrame.max, y: projectedYFrame.max },
      };
    }

    function projectWebMercator(
      latitude: number,
      longitude: number,
      mapWidth = 360,
      mapHeight = 360,
    ) {
      const clampedLatitude = Math.max(
        -85.05112878,
        Math.min(85.05112878, latitude),
      );
      return {
        x: longitude * (mapWidth / 360),
        y:
          Math.log(Math.tan(Math.PI / 4 + (clampedLatitude * Math.PI) / 360)) *
          (mapHeight / (2 * Math.PI)),
      };
    }

    function unprojectWebMercator(
      projectedX: number,
      projectedY: number,
      mapHeight = 360,
    ): GeoJsonPosition {
      const latitudeRadians =
        Math.atan(Math.exp(projectedY / (mapHeight / (2 * Math.PI)))) -
        Math.PI / 4;
      const latitude = (latitudeRadians * 360) / Math.PI;
      return [projectedX, latitude];
    }

    function fitProjectionFrame(pairs: [number, number][]) {
      if (pairs.length < 2) {
        return { min: 0, max: 1 };
      }

      let sumNormalized = 0;
      let sumProjected = 0;
      let sumNormalizedSquared = 0;
      let sumProduct = 0;

      pairs.forEach(([normalized, projected]) => {
        sumNormalized += normalized;
        sumProjected += projected;
        sumNormalizedSquared += normalized * normalized;
        sumProduct += normalized * projected;
      });

      const count = pairs.length;
      const denominator =
        count * sumNormalizedSquared - sumNormalized * sumNormalized;
      const slope =
        Math.abs(denominator) > 0.000001
          ? (count * sumProduct - sumNormalized * sumProjected) / denominator
          : 1;
      const intercept = (sumProjected - slope * sumNormalized) / count;
      const frameStart = intercept;
      const frameEnd = intercept + slope;

      return {
        min: Math.min(frameStart, frameEnd),
        max: Math.max(frameStart, frameEnd),
      };
    }

    function svgPointToLngLat(point: SvgPoint): GeoJsonPosition {
      const { svgBounds, projectedMin, projectedMax } = globalMercatorFrame;
      const width = Math.max(svgBounds.maxX - svgBounds.minX, 0.000001);
      const height = Math.max(svgBounds.maxY - svgBounds.minY, 0.000001);
      const normalizedX = (point.x - svgBounds.minX) / width;
      const normalizedY = (svgBounds.maxY - point.y) / height;
      const projectedX =
        projectedMin.x + (projectedMax.x - projectedMin.x) * normalizedX;
      const projectedY =
        projectedMin.y + (projectedMax.y - projectedMin.y) * normalizedY;
      return unprojectWebMercator(projectedX, projectedY);
    }

    function closeRing(ring: GeoJsonPosition[]) {
      const first = ring[0];
      const last = ring[ring.length - 1];
      if (!first || !last) {
        return ring;
      }

      if (first[0] === last[0] && first[1] === last[1]) {
        return ring;
      }

      return [...ring, first];
    }

    function disposeMap() {
      introCopy.removeEventListener("click", revealStateNetwork);
      introCopy.removeEventListener("keydown", handleIntroKeydown);
      regionReturn.removeEventListener("click", returnToStateView);
      map?.remove();
    }
  }
</script>

<style>
  /* ─── Volks-Typo design tokens ─────────────────────────────────────
     Ported from jdrhyne/volks-typo (Bauhaus / Vienna-signage blog theme).
     Monotone palette + accent red, Oswald + Roboto Condensed + Work
     Sans + JetBrains Mono. Dark-theme tokens applied at root since the
     interactive map sits behind everything and a white-paper palette
     would clash. The accent red (#dc2626 / dark #ff3333) sits within
     a couple of points of H-E-B's brand red, so the existing red on
     the map polygons reads as the same accent system.
     ───────────────────────────────────────────────────────────────── */
  @import url("https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Roboto+Condensed:wght@400;500;600;700&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap");

  :root {
    /* Monotone palette */
    --color-white: #ffffff;
    --color-light-gray: #f5f5f5;
    --color-medium-gray: #888888;
    --color-dark-gray: #333333;
    --color-black: #000000;

    /* Accent */
    --color-accent-red: #dc2626;

    /* Semantic tokens — dark theme (this app's overlay is on a 3D map,
       so the volks-typo dark theme tokens fit naturally). */
    --color-background: #0a0a0a;
    --color-surface: #1a1a1a;
    --color-text-primary: #f5f5f5;
    --color-text-secondary: #b8b8b8;
    --color-text-muted: #888888;
    --color-border: #333333;
    --color-accent: #ff3333;

    /* Typography stack */
    --font-heading-primary: "Oswald", sans-serif;
    --font-heading-secondary: "Roboto Condensed", sans-serif;
    --font-body: "Work Sans", sans-serif;
    --font-mono: "JetBrains Mono", monospace;

    /* Grid */
    --grid-unit: 8px;
    --max-width: 1200px;
    --content-padding: calc(var(--grid-unit) * 3);
  }

  :global(html),
  :global(body) {
    min-height: 100%;
    margin: 0;
  }

  :global(body) {
    overflow: hidden;
    font-family: var(--font-body);
  }

  .heb-landing {
    position: relative;
    width: 100vw;
    height: 100vh;
    min-height: 620px;
    overflow: hidden;
    color: var(--color-text-primary);
    background:
      radial-gradient(
        circle at 50% 28%,
        rgba(244, 248, 252, 0.44),
        rgba(169, 180, 190, 0.16) 34%,
        transparent 60%
      ),
      linear-gradient(145deg, #d9dfe4 0%, #aeb8c2 52%, #87929d 100%);
    font-family: var(--font-body);
    isolation: isolate;
  }

  .heb-landing::before {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    content: "";
    background:
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.08) 0 1px,
        transparent 1px 4px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(30, 40, 50, 0.05) 0 1px,
        transparent 1px 5px
      );
    mix-blend-mode: soft-light;
    opacity: 0.72;
  }

  .heb-landing::after {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    content: "";
    background:
      radial-gradient(
        circle at 50% 50%,
        transparent 0 42%,
        rgba(65, 75, 86, 0.18) 100%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.18),
        transparent 22%,
        rgba(43, 53, 63, 0.2)
      );
  }

  .heb-landing__scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  :global(.heb-landing__scene .maplibregl-canvas) {
    background: transparent;
    outline: none;
  }

  :global(.heb-landing__scene .maplibregl-control-container) {
    display: none;
  }

  .heb-landing__hud {
    position: absolute;
    inset: 0;
    z-index: 10;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }

  .heb-landing__nav {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    left: 50%;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.35rem, 2vw, 1.15rem);
    width: min(92vw, 520px);
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    box-shadow: 0 18px 44px rgba(35, 45, 56, 0.16);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
    pointer-events: auto;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .heb-landing[data-regional-view="true"] .heb-landing__nav {
    opacity: 0;
    transform: translateX(-50%) translateY(-0.65rem);
    pointer-events: none;
  }

  .heb-landing__nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-heading-secondary);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(35, 45, 56, 0.26);
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .heb-landing__nav a:hover,
  .heb-landing__nav a:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-1px);
  }

  .heb-landing__intro {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: grid;
    place-items: center;
    border: 0;
    outline: none;
    pointer-events: none;
  }

  .heb-landing__copy {
    position: relative;
    z-index: 10;
    width: min(92vw, 980px);
    padding: 0 1.25rem;
    text-align: center;
    text-shadow:
      0 12px 34px rgba(40, 48, 58, 0.32),
      0 2px 12px rgba(80, 17, 22, 0.16);
    transform-origin: center;
    will-change: opacity, transform;
    cursor: pointer;
    pointer-events: auto;
  }

  .heb-landing[data-view-state="state-network"] .heb-landing__copy,
  .heb-landing[data-view-state="regional"] .heb-landing__copy {
    visibility: hidden;
    opacity: 0;
    transform: scale(0.88);
    pointer-events: none;
  }

  .heb-landing__copy:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.8);
    outline-offset: 0.8rem;
  }

  .heb-landing__eyebrow {
    margin: 0 0 0.65rem;
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-heading-secondary);
    font-size: clamp(0.72rem, 1.3vw, 0.9rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .heb-landing__copy h1 {
    margin: 0;
    color: #fff;
    font-family: var(--font-heading-primary);
    font-size: clamp(3.3rem, 10vw, 8.8rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .heb-landing__subtitle {
    margin: clamp(0.7rem, 2vw, 1.2rem) 0 0;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-heading-secondary);
    font-size: clamp(1.05rem, 2.4vw, 1.65rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .heb-landing__actions {
    position: absolute;
    bottom: clamp(1.2rem, 5.5vw, 3.6rem);
    left: 50%;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: min(92vw, 520px);
    transform: translateX(-50%);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
    pointer-events: none;
  }

  .heb-landing[data-regional-view="true"] .heb-landing__actions {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(0.65rem);
  }

  .heb-landing__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 10.5rem;
    min-height: 3.05rem;
    padding: 0 1.6rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    color: #fff;
    font-family: var(--font-heading-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow:
      0 18px 36px rgba(42, 52, 63, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(16px);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
    pointer-events: auto;
  }

  .heb-landing__button:hover,
  .heb-landing__button:focus-visible {
    transform: translateY(-2px);
  }

  .heb-landing__button--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .heb-landing__button--secondary {
    background: rgba(255, 255, 255, 0.16);
  }

  .heb-landing__button--primary:hover,
  .heb-landing__button--primary:focus-visible {
    background: var(--color-accent-red);
    border-color: var(--color-accent-red);
  }

  .heb-landing__button--secondary:hover,
  .heb-landing__button--secondary:focus-visible {
    background: rgba(255, 255, 255, 0.24);
  }

  .heb-landing__region-hud {
    position: absolute;
    inset: 0;
    z-index: 11;
    width: 100vw;
    height: 100vh;
    color: #fff;
    text-align: center;
    text-shadow: 0 12px 30px rgba(24, 32, 42, 0.38);
    pointer-events: none;
  }

  .heb-landing__region-hud[hidden] {
    display: none;
  }

  /* ─────────────────────────────────────────────────────────────────
     Selection panel — minimalist glass-card matching the existing HUD
     language (translucent, subtle borders, white text, backdrop blur).
     Designed to sit unobtrusively on the right edge during regional
     view; scrolls internally when the traversal list grows.
     ───────────────────────────────────────────────────────────────── */
  .heb-landing__selection-panel {
    position: absolute;
    top: clamp(0.75rem, 2.5vh, 1.25rem);
    right: clamp(0.65rem, 1.5vw, 1.1rem);
    bottom: auto;
    z-index: 12;
    display: flex;
    flex-direction: column;
    width: min(86vw, 15.5rem);
    max-height: calc(100vh - clamp(1.5rem, 5vh, 2.5rem));
    padding: 0.65rem 0.7rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.9rem;
    background: rgba(18, 22, 28, 0.42);
    box-shadow:
      0 16px 40px rgba(18, 24, 32, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    color: rgba(255, 255, 255, 0.92);
    overflow: hidden;
    pointer-events: auto;
  }

  .heb-landing__selection-panel[hidden] {
    display: none;
  }

  .heb-landing__selection-panel-header {
    flex: 0 0 auto;
    padding-bottom: 0.4rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .heb-landing__selection-panel-kicker {
    margin: 0 0 0.1rem;
    color: var(--color-accent);
    font-family: var(--font-heading-secondary);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .heb-landing__selection-panel-title {
    margin: 0 0 0.15rem;
    color: #fff;
    font-family: var(--font-heading-primary);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .heb-landing__selection-panel-count {
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .heb-landing__selection-list {
    flex: 1 1 auto;
    margin: 0;
    padding: 0 0.1rem 0.1rem;
    list-style: none;
    overflow-y: auto;
    overflow-x: hidden;
    counter-reset: heb-selection;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
  }

  .heb-landing__selection-list::-webkit-scrollbar {
    width: 6px;
  }

  .heb-landing__selection-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
  }

  /* Each list item starts collapsed so anime.js can interpolate height
     from 0 → its natural size on insert. `overflow: hidden` is required
     for the height tween to actually clip. */
  .heb-landing__selection-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 0.45rem 0.1rem 0.45rem 1.65rem;
    counter-increment: heb-selection;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
    height: 0;
    opacity: 0;
    transition: background-color 160ms ease;
    will-change: height, opacity;
  }

  .heb-landing__selection-item:last-child {
    border-bottom: none;
  }

  .heb-landing__selection-item:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  /* Ordinal number — auto-managed by CSS counter so removals re-number
     without us touching the DOM. Tinted to the parent route's color
     (set on the route section as --route-color) so the ordinal reads
     as part of the route badge. */
  .heb-landing__selection-item::before {
    position: absolute;
    top: 0.55rem;
    left: 0.1rem;
    content: counter(heb-selection, decimal-leading-zero);
    color: var(--route-color, rgba(225, 25, 33, 0.85));
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    filter: brightness(1.4);
  }

  .heb-landing__selection-item-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .heb-landing__selection-item-name {
    margin: 0 0 0.1rem;
    color: #fff;
    font-family: var(--font-heading-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .heb-landing__selection-item-address {
    margin: 0 0 0.12rem;
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.35;
    word-break: break-word;
  }

  .heb-landing__selection-item-region {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .heb-landing__selection-item-remove {
    flex: 0 0 auto;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0;
    margin-top: 0.05rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .heb-landing__selection-item-remove:hover,
  .heb-landing__selection-item-remove:focus-visible {
    border-color: rgba(225, 25, 33, 0.6);
    background: rgba(225, 25, 33, 0.18);
    color: #fff;
    outline: none;
    transform: scale(1.06);
  }

  .heb-landing__selection-empty {
    margin: 0;
    padding: 0.35rem 0.1rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .heb-landing__selection-empty[hidden] {
    display: none;
  }

  /* ─── Route accordion ────────────────────────────────────────────
     Six color-coded route sections, strict-accordion (one open at a
     time). The active section's body expands; others stay collapsed.
     `--route-color` is a per-section CSS variable set inline in JS
     (initRouteAccordion) so every visual highlight derives from a
     single source.
     ─────────────────────────────────────────────────────────────── */
  .heb-landing__route-accordion {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    margin-top: 0.05rem;
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 0.1rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
  }

  .heb-landing__route-accordion::-webkit-scrollbar {
    width: 6px;
  }

  .heb-landing__route-accordion::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
  }

  .heb-landing__route-section {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 0.7rem;
    overflow: hidden;
  }

  /* Hamburger-button header: the whole pill is painted in the route's
     color, with its text color set per-route (yellow gets dark text;
     others get white). Hovering and pressing nudge the background
     darker/lighter so the affordance feels tactile across all six
     route colors without per-route hover rules. */
  .heb-landing__route-header {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.45rem 0.65rem;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 0.55rem;
    background: var(--route-color);
    color: var(--route-text-color, #ffffff);
    font: inherit;
    font-family: var(--font-heading-primary);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition:
      filter 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .heb-landing__route-label {
    flex: 1 1 auto;
    font-family: var(--font-heading-primary);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.25);
  }

  .heb-landing__route-header:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .heb-landing__route-header:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.7);
    outline-offset: 2px;
  }

  .heb-landing__route-header:active {
    filter: brightness(0.94);
    transform: translateY(0);
  }

  /* When a section is OPEN, square the header's bottom corners so it
     visually fuses with the body underneath. Open and "active" are
     independent — a route can be active while collapsed, or open while
     inactive. */
  .heb-landing__route-section[data-route-open="true"]
    .heb-landing__route-header {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -2px 0 rgba(0, 0, 0, 0.18);
  }

  /* Active-route highlight (where new clicks land). Stays present even
     when the section is collapsed — a soft outer ring in the route's
     color so the user can tell at a glance which list their next click
     will add to. */
  .heb-landing__route-section[data-route-active="true"]
    .heb-landing__route-header {
    outline: 2px solid rgba(255, 255, 255, 0.55);
    outline-offset: 1px;
  }

  /* Chevron icon — `▾`. Rotates 180° when its section is open so
     closed/open states read at a glance. */
  .heb-landing__route-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    font-size: 0.7rem;
    line-height: 1;
    border-radius: 0.3rem;
    background: rgba(0, 0, 0, 0.12);
    transition:
      transform 240ms ease,
      background-color 160ms ease;
  }

  /* Shinkansen-ETA pill. Background + text colors are set inline per
     route (see initRouteAccordion): pill background = the route's
     `textColor`, pill text = the route's `lineColor`. The pill is
     hidden when empty (fewer than 2 stations selected) so it doesn't
     show a stray dot in the header. */
  .heb-landing__route-eta {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.42rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
  }

  .heb-landing__route-eta:empty {
    display: none;
  }

  .heb-landing__route-header:hover .heb-landing__route-icon {
    background: rgba(0, 0, 0, 0.18);
  }

  .heb-landing__route-section[data-route-open="true"]
    .heb-landing__route-icon {
    transform: rotate(180deg);
    background: rgba(0, 0, 0, 0.22);
  }

  /* CSS-only accordion expansion. When the section is inactive the
     body collapses to zero height; when active it fades + grows into
     a small panel that visually fuses with the bottom of the colored
     hamburger header. */
  .heb-landing__route-body {
    overflow: hidden;
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: none;
    border-bottom-left-radius: 0.55rem;
    border-bottom-right-radius: 0.55rem;
    padding: 0.25rem 0.5rem 0.4rem;
  }

  /* The selection list inside each route body shares the existing
     `.heb-landing__selection-list` styles, but the CSS counter must
     reset per route so each route's ordinals start at 01. */
  .heb-landing__route-body .heb-landing__selection-list {
    counter-reset: heb-selection;
  }

  @media (max-width: 720px) {
    .heb-landing__selection-panel {
      top: auto;
      right: 0.65rem;
      bottom: max(0.65rem, env(safe-area-inset-bottom));
      width: calc(100vw - 1.3rem);
      max-height: 42vh;
    }
  }

  .heb-landing__region-title {
    position: absolute;
    top: clamp(1rem, 3vh, 1.9rem);
    left: 50%;
    width: min(92vw, 620px);
    padding: 0 1rem;
    transform: translateX(-50%);
    opacity: 0;
    will-change: opacity;
    pointer-events: none;
  }

  .heb-landing__region-kicker {
    margin: 0 0 0.45rem;
    color: var(--color-accent);
    font-family: var(--font-heading-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .heb-landing__region-hud h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-heading-primary);
    font-size: clamp(0.9rem, 1.6vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .heb-landing__region-return {
    position: absolute;
    bottom: clamp(1.2rem, 6vh, 3.9rem);
    left: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.7rem;
    padding: 0 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 999px;
    color: #fff;
    background: rgba(15, 19, 24, 0.36);
    box-shadow:
      0 18px 34px rgba(24, 32, 42, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    font: inherit;
    font-family: var(--font-heading-secondary);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(16px);
    cursor: pointer;
    opacity: 0;
    transform: translateX(-50%);
    will-change: opacity;
    pointer-events: auto;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .heb-landing__region-return:hover,
  .heb-landing__region-return:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateX(-50%) translateY(-2px);
  }

  @media (max-width: 720px) {
    .heb-landing {
      min-height: 100svh;
    }

    .heb-landing__nav {
      width: calc(100vw - 1rem);
      gap: 0.15rem;
      padding: 0.35rem;
    }

    .heb-landing__nav a {
      min-height: 2.05rem;
      padding: 0 0.55rem;
      font-size: 0.72rem;
    }

    .heb-landing__copy {
      width: min(94vw, 520px);
    }

    .heb-landing__actions {
      bottom: max(1rem, env(safe-area-inset-bottom));
      gap: 0.55rem;
