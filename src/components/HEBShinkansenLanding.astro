                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"></rect>
                  <line
                    x1="16"
                    y1="2"
                    x2="16"
                    y2="20"
                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <line
                    x1="2"
                    y1="20"
                    x2="30"
                    y2="20"
                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <rect
                    x="14"
                    y="8"
                    width="4"
                    height="8"
                    rx="2"
                    fill="currentColor"></rect>
                </svg>
              </span>
              <div class="heb-landing__getstarted-text">
                <span class="heb-landing__getstarted-label">Right click</span>
                <span class="heb-landing__getstarted-desc"
                  >Rotate &amp; tilt the camera</span
                >
              </div>
            </li>
            <li class="heb-landing__getstarted-control">
              <span class="heb-landing__getstarted-icon" aria-hidden="true">
                <svg viewBox="0 0 32 48" xmlns="http://www.w3.org/2000/svg">
                  <rect
                    x="2"
                    y="2"
                    width="28"
                    height="44"
                    rx="14"
                    ry="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"></rect>
                  <line
                    x1="16"
                    y1="2"
                    x2="16"
                    y2="20"
                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <line
                    x1="2"
                    y1="20"
                    x2="30"
                    y2="20"
                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <rect
                    x="13"
                    y="6"
                    width="6"
                    height="12"
                    rx="3"
                    class="heb-landing__getstarted-icon-accent"
                    fill="currentColor"></rect>
                  <path
                    d="M16 1 L13 4 M16 1 L19 4"
                    stroke="currentColor"
                    stroke-width="1.4"
                    fill="none"
                    stroke-linecap="round"></path>
                  <path
                    d="M16 23 L13 20 M16 23 L19 20"
                    stroke="currentColor"
                    stroke-width="1.4"
                    fill="none"
                    stroke-linecap="round"></path>
                </svg>
              </span>
              <div class="heb-landing__getstarted-text">
                <span class="heb-landing__getstarted-label">Mouse wheel</span>
                <span class="heb-landing__getstarted-desc"
