---
import { hebStores as hebStoreData } from "../data/hebGeoData";

const stationCount = hebStoreData.length;
---

<section
  class="heb-landing"
  aria-labelledby="heb-title heb-subtitle"
  data-map-root
  data-view-state="landing"
  data-regional-view="false"
>
  <div
    class="heb-landing__scene"
    data-map-scene
    aria-label="Interactive geolocated Texas H-E-B high speed rail map"
  >
  </div>

  <div class="heb-landing__hud" data-ui-hud>
    <nav class="heb-landing__nav" aria-label="Primary">
      <a href="#home" data-nav-home>Home</a>
      <a href="#regions" data-regions-trigger>Regions</a>
      <a href="#cities" data-cities-trigger>Cities</a>
      <a href="#about" data-details-trigger>About</a>
    </nav>

    <div class="heb-landing__intro" data-map-trigger>
      <div
        class="heb-landing__copy"
        data-intro-copy
        role="button"
        tabindex="0"
        aria-label={`Reveal statewide H-E-B station network with ${stationCount} Texas stations`}
      >
        <p class="heb-landing__eyebrow">Texas H-E-B Guide</p>
        <h1 id="heb-title">HEB</h1>
        <h2 id="heb-subtitle">High Speed Rail</h2>
        <p class="heb-landing__subtitle">Choose your Stations</p>
      </div>
    </div>

    <div class="heb-landing__actions" aria-label="Map actions">
      <a
        class="heb-landing__button heb-landing__button--primary"
        href="#start"
        data-getstarted-trigger>GET STARTED</a
      >
    </div>

    <div class="heb-landing__visits" data-visits>
      <button
        type="button"
        class="heb-landing__visits-button"
        data-visits-toggle
        aria-label="Site visit count"
        aria-expanded="false"
      >
        <img src="/lil-cowboy.svg" alt="" class="heb-landing__visits-hat" />
      </button>
      <div
        class="heb-landing__visits-popup"
        data-visits-popup
        role="status"
        hidden
      >
        This site was visited
        <span class="heb-landing__visits-count" data-visits-count>—</span>
        times
      </div>
    </div>

    <div class="heb-landing__region-hud" data-region-hud hidden>
      <button
        class="heb-landing__region-close-mobile"
        type="button"
        data-region-close-mobile
        aria-label="Return to state view"
      >
        <span aria-hidden="true">×</span>
      </button>
      <div class="heb-landing__region-title" data-region-title-panel>
        <p class="heb-landing__region-kicker">Regional View</p>
        <h2 data-region-title>SOUTH TEXAS REGIONAL NETWORK</h2>
      </div>
      <button
        class="heb-landing__region-return"
        type="button"
        data-region-return>Return to State View</button
      >
    </div>

    <aside
      class="heb-landing__selection-panel"
      data-selection-panel
      aria-label="Selected H-E-B stations"
      hidden
    >
      <button
        type="button"
        class="heb-landing__selection-clear"
        data-clear-routes
        aria-label="Clear all routes"
        hidden
      >
        <span aria-hidden="true">×</span>
        <span class="heb-landing__selection-clear-label">Clear</span>
      </button>
      <header class="heb-landing__selection-panel-header">
        <p class="heb-landing__selection-panel-kicker">Your Traversal</p>
        <h3 class="heb-landing__selection-panel-title">Routes</h3>
        <p
          class="heb-landing__selection-panel-count"
          data-selection-count
          aria-live="polite"
        >
          0 stations
        </p>
        <button
          type="button"
          class="heb-landing__panel-toggle"
          data-panel-toggle
          aria-label="Toggle routes panel"
          aria-expanded="true"
        >
          <span aria-hidden="true">▾</span>
        </button>
      </header>
      <div
        class="heb-landing__route-accordion"
        data-route-accordion
        role="list"
      >
      </div>
      <button
        type="button"
        class="heb-landing__show-routes"
        data-show-routes-toggle
        data-active="false"
        aria-label="Toggle showing only route stores on the map"
      >
        <span data-show-routes-label>Show Routes</span>
      </button>
    </aside>

    <div
      class="heb-landing__route-dots"
      data-route-dots
      aria-label="Quick route picker"
    >
    </div>

    <div
      class="heb-landing__modal"
      data-details-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="details-modal-title"
      hidden
    >
      <button
        type="button"
        class="heb-landing__modal-backdrop"
        data-details-close
        aria-label="Close details"></button>
      <div class="heb-landing__modal-card" role="document">
        <button
          type="button"
          class="heb-landing__modal-close"
          data-details-close
          aria-label="Close"
        >
          <span aria-hidden="true">×</span>
        </button>
        <p class="heb-landing__modal-kicker">Texas H-E-B Guide</p>
        <h2 id="details-modal-title" class="heb-landing__modal-title">
          About this project
        </h2>
        <div class="heb-landing__modal-body">
          <p>
            Hello, you&rsquo;re here because you&rsquo;re curious about how many
            H-E-Bs there are in Texas, and what would happen if
            H&#8209;E&#8209;B had a high-speed railroad station at every one of
            them. A Current train ride from Austin to San Antonio is 3 hrs
            long...Imagine the travel time on a H-E-B high speed rail.
          </p>
          <p>
            If you&rsquo;re a Texan, you know there&rsquo;s no public
            transportation that exists at this scale&#8230; yet&#8230; One can
            hope public transit will be built out in Texas.
          </p>
          <p>
            Thank you for visiting. I&rsquo;m a software developer and 3D
            artist based in Texas. I love the state, the culture, the people,
            and most of all, H&#8209;E&#8209;B. Thank you, Texas, for being
            such an amazing home.
          </p>
          <p class="heb-landing__modal-postscript">
            <strong>P.S.</strong> If you&rsquo;re looking to hire someone for marketing/animations,
            <a
              class="heb-landing__reach-out"
              href="https://brainrotalot.com/"
              target="_blank"
              rel="noopener noreferrer"
              >reach out</a
            >.
          </p>
          <div class="heb-landing__techstack">
            <p class="heb-landing__techstack-title">What was used:</p>
            <ul class="heb-landing__techstack-grid">
              <li class="heb-landing__techstack-item">
                <img
                  src="/icons/astro.svg"
                  alt=""
                  class="heb-landing__techstack-icon"
                />
                <span class="heb-landing__techstack-name">Astro</span>
              </li>
              <li class="heb-landing__techstack-item">
                <img
                  src="/icons/blender.svg"
                  alt=""
                  class="heb-landing__techstack-icon"
                />
                <span class="heb-landing__techstack-name">Blender</span>
              </li>
              <li class="heb-landing__techstack-item">
                <img
                  src="/icons/maplibre.svg"
                  alt=""
                  class="heb-landing__techstack-icon"
                />
                <span class="heb-landing__techstack-name">MapLibre GL JS</span>
              </li>
              <li class="heb-landing__techstack-item">
                <img
                  src="/icons/claude.svg"
                  alt=""
                  class="heb-landing__techstack-icon"
                />
                <span class="heb-landing__techstack-name">Claude</span>
              </li>
              <li class="heb-landing__techstack-item">
                <img
                  src="/icons/threejs.svg"
                  alt=""
                  class="heb-landing__techstack-icon"
                />
                <span class="heb-landing__techstack-name">Three.js</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

      <div
        class="heb-landing__modal"
        data-cities-modal
        role="dialog"
        aria-modal="true"
        aria-labelledby="cities-modal-title"
        hidden
      >
        <button
          type="button"
          class="heb-landing__modal-backdrop"
          data-cities-close
          aria-label="Close cities"></button>
        <div class="heb-landing__modal-card" role="document">
          <button
            type="button"
            class="heb-landing__modal-close"
            data-cities-close
            aria-label="Close"
          >
            <span aria-hidden="true">×</span>
          </button>
          <p class="heb-landing__modal-kicker">Texas H-E-B Guide</p>
          <h2 id="cities-modal-title" class="heb-landing__modal-title">
            Cities by Population
          </h2>
          <p class="heb-landing__cities-subtitle">
            Texas cities ranked by population; only those with H&#8209;E&#8209;B
            locations are shown.
          </p>
          <ol class="heb-landing__cities-list" data-cities-list></ol>
        </div>
      </div>

      <div
        class="heb-landing__modal"
        data-getstarted-modal
        role="dialog"
        aria-modal="true"
        aria-labelledby="getstarted-modal-title"
        hidden
