                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <line
                    x1="2"
                    y1="20"
                    x2="30"
                    y2="20"
                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <rect
                    x="14"
                    y="8"
                    width="4"
                    height="8"
                    rx="2"
                    fill="currentColor"></rect>
                </svg>
              </span>
              <div class="heb-landing__getstarted-text">
                <span class="heb-landing__getstarted-label">Left click</span>
                <span class="heb-landing__getstarted-desc">Select</span>
              </div>
            </li>
            <li class="heb-landing__getstarted-control">
              <span class="heb-landing__getstarted-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M2 16 A14 14 0 0 1 16 2 L16 20 L2 20 Z"
                    fill="currentColor"
                    class="heb-landing__getstarted-icon-accent"></path>
                  <rect
                    x="2"
                    y="2"
                    width="28"
                    height="44"
                    rx="14"
                    ry="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"></rect>
                  <line
                    x1="16"
                    y1="2"
                    x2="16"
                    y2="20"
                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <line
                    x1="2"
                    y1="20"
                    x2="30"
                    y2="20"
                    stroke="currentColor"
                    stroke-width="1.2"></line>
                  <rect
                    x="14"
                    y="8"
                    width="4"
                    height="8"
                    rx="2"
                    fill="currentColor"></rect>
                  <path
                    d="M36 22 L44 22 M40 18 L44 22 L40 26"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                  <path
                    d="M44 32 L36 32 M40 28 L36 32 L40 36"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <div class="heb-landing__getstarted-text">
                <span class="heb-landing__getstarted-label"
                  >Left click (hold)</span
                >
                <span class="heb-landing__getstarted-desc">Pan the map</span>
              </div>
            </li>
            <li class="heb-landing__getstarted-control">
              <span class="heb-landing__getstarted-icon" aria-hidden="true">
                <svg viewBox="0 0 32 48" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M16 2 A14 14 0 0 1 30 16 L30 20 L16 20 Z"
                    fill="currentColor"
                    class="heb-landing__getstarted-icon-accent"></path>
                  <rect
                    x="2"
                    y="2"
                    width="28"
                    height="44"
                    rx="14"
