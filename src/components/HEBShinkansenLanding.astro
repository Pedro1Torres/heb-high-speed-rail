          </ul>
        </div>
      </div>

      <div
        class="heb-landing__modal"
        data-regions-modal
        role="dialog"
        aria-modal="true"
        aria-labelledby="regions-modal-title"
        hidden
      >
        <button
          type="button"
          class="heb-landing__modal-backdrop"
          data-regions-close
          aria-label="Close regions"></button>
        <div class="heb-landing__modal-card" role="document">
          <button
            type="button"
            class="heb-landing__modal-close"
            data-regions-close
            aria-label="Close"
          >
            <span aria-hidden="true">×</span>
          </button>
          <p class="heb-landing__modal-kicker">Texas H-E-B Guide</p>
          <h2 id="regions-modal-title" class="heb-landing__modal-title">
            Regions
          </h2>
          <div class="heb-landing__regions-tree" data-regions-tree></div>
        </div>
      </div>

      <div
        class="heb-landing__station-tooltip"
        data-station-tooltip
        role="tooltip"
        aria-hidden="true"
        hidden
      >
        <p class="heb-landing__station-tooltip-name" data-station-tooltip-name>
        </p>
        <p
          class="heb-landing__station-tooltip-address"
          data-station-tooltip-address
        >
        </p>
      </div>
  </div>

  <script>
    import { animate, createTimeline } from "animejs";
    import maplibregl, {
      type Map as MapLibreMap,
      type MapLayerMouseEvent,
    } from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";
    import * as THREE from "three";
    import { DRACOLoader } from "three/examples/jsm/loaders/DRACOLoader.js";
    import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
    import { hebStores, texasPath } from "../data/hebGeoData";

    const root = document.querySelector<HTMLElement>("[data-map-root]");
    const mapHost = root?.querySelector<HTMLElement>("[data-map-scene]");
    const introCopy = root?.querySelector<HTMLElement>("[data-intro-copy]");
    const regionHud = root?.querySelector<HTMLElement>("[data-region-hud]");
    const regionTitlePanel = root?.querySelector<HTMLElement>(
      "[data-region-title-panel]",
    );
    const regionTitle = root?.querySelector<HTMLElement>("[data-region-title]");
    const regionReturn = root?.querySelector<HTMLButtonElement>(
      "[data-region-return]",
    );
    const regionCloseMobile = root?.querySelector<HTMLButtonElement>(
      "[data-region-close-mobile]",
    );
    const selectionPanel = root?.querySelector<HTMLElement>(
      "[data-selection-panel]",
    );
    const panelToggle = root?.querySelector<HTMLButtonElement>(
      "[data-panel-toggle]",
    );
    const routeDots = root?.querySelector<HTMLElement>("[data-route-dots]");
    const accordionContainer = root?.querySelector<HTMLElement>(
      "[data-route-accordion]",
    );
    const selectionCount = root?.querySelector<HTMLElement>(
      "[data-selection-count]",
    );
    const stationTooltip = root?.querySelector<HTMLElement>(
      "[data-station-tooltip]",
    );
    const stationTooltipName = stationTooltip?.querySelector<HTMLElement>(
      "[data-station-tooltip-name]",
    );
    const stationTooltipAddress = stationTooltip?.querySelector<HTMLElement>(
      "[data-station-tooltip-address]",
    );

    if (
      root &&
      mapHost &&
      introCopy &&
      regionHud &&
      regionTitlePanel &&
      regionTitle &&
      regionReturn &&
      regionCloseMobile &&
      selectionPanel &&
      panelToggle &&
      routeDots &&
      accordionContainer &&
      selectionCount
    ) {
      type SvgPoint = { x: number; y: number };
      type SvgBounds = {
        minX: number;
        maxX: number;
        minY: number;
        maxY: number;
      };
      type GeoJsonPosition = [number, number];
      type GlobalMercatorFrame = {
        svgBounds: SvgBounds;
        projectedMin: { x: number; y: number };
        projectedMax: { x: number; y: number };
      };
      type TexasRegionSpec = {
        id: string;
        name: string;
        clips: SvgPoint[][];
      };
      type RegionDefinition = {
        id: string;
        name: string;
        svgPolygons: SvgPoint[][];
        coordinates: GeoJsonPosition[][][];
        bounds: maplibregl.LngLatBounds;
      };
      type StoreDefinition = (typeof hebStores)[number] & {
        regionId: string;
        regionName: string;
      };
      type MapGeometry =
        | { type: "Polygon"; coordinates: GeoJsonPosition[][] }
        | { type: "LineString"; coordinates: GeoJsonPosition[] };
      type MapFeature = {
        type: "Feature";
        id?: string;
        properties: Record<string, unknown>;
        geometry: MapGeometry;
      };
      type MapFeatureCollection = {
        type: "FeatureCollection";
        features: MapFeature[];
      };
      type ViewState = "landing" | "state-network" | "regional";
      type StationMode = "hidden" | "state" | "regional";
      type RouteId = "black" | "blue" | "yellow" | "pink" | "purple" | "orange";
      type StoreTileEntry = {
        storeId: string;
        modelGroup: THREE.Group;
        storeModel: THREE.Group;
        baseModelScale: number;
        stateMarkerGroup: THREE.Group;
        stateMarkerModel: THREE.Group;
        stateMarkerScale: number;
        regionId: string;
      };
      type StoreTileLayer = {
        id: string;
        type: "custom";
        renderingMode: "3d";
        onAdd: (
          mapArg: MapLibreMap,
          gl: WebGLRenderingContext | WebGL2RenderingContext,
        ) => void;
        render: (
          gl: WebGLRenderingContext | WebGL2RenderingContext,
          args: unknown,
        ) => void;
        onRemove: () => void;
        setMode: (mode: StationMode, regionId?: string) => void;
        setHoveredStore: (storeId: string | null) => void;
        pulseStore: (storeId: string) => void;
        setRoute: (
          routeId: RouteId,
          coordinates: GeoJsonPosition[] | null,
        ) => void;
        setStoreColors: (storeId: string, hexColors: string[]) => void;
        setStateMarkerFilter: (
          enabled: boolean,
          selectedIds: Set<string>,
        ) => void;
      };

      const svgSnapPrecision = 0.001;
      const openFreeMapStyleUrl = "https://tiles.openfreemap.org/styles/bright";
      const storeModelUrl = "/models/HEB_Store.glb";
      const stateMarkerModelUrl = "/models/HEB_cowboy_hat.glb";
      const trainModelUrl = "/models/HEB_train_and_tracks.glb";
      const regularStoreFootprintMeters = 1240;
      const hubStoreFootprintMeters = 1620;
      // ─── Density-based footprint scaling ─────────────────────────────
      // For sparse regions (West Texas, North Texas) the regional fly-in
      // lands at a wide zoom and the default 1240m store reads as a
      // speck. We measure each store's distance to its NEAREST sibling
      // inside the same region and pick a multiplier from a bucketed
      // scale: closer neighbors mean smaller buildings (to avoid
      // overlap), further neighbors mean huge buildings (so the user
      // can see + click them). Per-city overrides win when a city's two
      // stores sit so close together that even the smallest bucket
      // would overlap (Del Rio).
      //
      // Regions outside this set keep the default 1× footprint — they're
      // already dense enough that bumping them risks unintended overlap.
      const RESIZED_REGIONS = new Set<string>([
        "west",
        "north",
        "east",
        "gulf",
        "south",
        "central",
      ]);
      const STORE_MULTIPLIER_OVERRIDES: Record<string, number> = {
        // Del Rio's two stores sit ~0.95 km apart — closer than the
        // default building footprint. Anything ≥ 1× overlaps; 0.6×
        // (744m each) gives ~200 m clearance.
        "Del Rio": 0.6,
      };
      const regularStateMarkerFootprintMeters = 18000;
