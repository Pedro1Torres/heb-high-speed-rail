      // Cities modal — ranked Texas-city population list with an
      // animated counter + progress bar per city, plus medal cowboy
      // hats on the top 3. Cities list comes from storeDefinitions
      // joined with TEXAS_CITY_POPULATIONS; cities without a population
      // entry simply don't appear (keeps small towns from cluttering
      // the modal). Counters re-animate every time the modal opens.
      function initCitiesModal() {
        const modal = root.querySelector<HTMLElement>("[data-cities-modal]");
        const list = root.querySelector<HTMLElement>("[data-cities-list]");
        if (!modal || !list) return;

        // Rough 2023-era population estimates for every HEB-host city
        // big enough to be worth ranking. Doesn't have to be perfect —
        // this is for visual fun. City keys match the exact spelling
        // used in hebGeoData.ts (so "Mckinney" not "McKinney").
        const TEXAS_CITY_POPULATIONS: Record<string, number> = {
          Houston: 2304580,
          "San Antonio": 1495295,
          Austin: 961855,
          "Fort Worth": 956709,
          "Corpus Christi": 317773,
          Plano: 285494,
          Lubbock: 263930,
          Laredo: 256529,
          Frisco: 219587,
          Mckinney: 207654,
          Cypress: 192000,
          Brownsville: 186738,
          Pasadena: 145860,
          Mcallen: 143920,
          Waco: 138486,
          "Round Rock": 133372,
          Midland: 132524,
          Pearland: 125817,
          Abilene: 125182,
          "College Station": 120019,
          "The Woodlands": 116278,
          Odessa: 114428,
          "League City": 114396,
          Beaumont: 111256,
          "Sugar Land": 111026,
          Allen: 105623,
          "New Braunfels": 102000,
          "San Angelo": 99893,
          Conroe: 98081,
          Baytown: 84000,
          Mansfield: 76247,
          Georgetown: 75420,
          "Missouri City": 75000,
          "San Marcos": 67553,
          Pflugerville: 65191,
          Kingwood: 65000,
          Spring: 62176,
          "Port Arthur": 53000,
          Burleson: 53000,
          "Texas City": 51898,
          Rockwall: 49000,
          Waxahachie: 43000,
          Friendswood: 41213,
          Cleburne: 32000,
          "Del Rio": 33867,
          "Deer Park": 33470,
          Lufkin: 35000,
          Prosper: 38000,
          Forney: 30000,
        };

        // Unique cities present in our store dataset, joined with the
        // population table. Sorted descending; cities missing a
        // population entry are dropped so the modal stays clean.
        const seen = new Set<string>();
        const cities = storeDefinitions
          .filter((store) => {
            if (seen.has(store.city)) return false;
            seen.add(store.city);
            return true;
          })
          .filter((store) => TEXAS_CITY_POPULATIONS[store.city] !== undefined)
          .map((store) => ({
            name: store.city,
            population: TEXAS_CITY_POPULATIONS[store.city],
            storeCount: storeDefinitions.filter((s) => s.city === store.city)
              .length,
          }))
          .sort((a, b) => b.population - a.population);

        const maxPopulation = cities[0]?.population ?? 1;

        // Build the list once at init. Population numbers start at 0 in
        // the DOM and animate to their final value each time the modal
        // is opened.
        cities.forEach((city, index) => {
          const rank = index + 1;
          const item = document.createElement("li");
          item.className = "heb-landing__cities-item";
          item.dataset.population = String(city.population);
          item.dataset.maxPopulation = String(maxPopulation);
          item.style.display = "block";

          const body = document.createElement("div");
          body.className = "heb-landing__cities-body";
          body.style.display = "flex";
          body.style.flexDirection = "column";
          body.style.gap = "0.3rem";

          const header = document.createElement("div");
          header.className = "heb-landing__cities-header";
          // Inline flex with three slots: rank, city name (fills the
          // middle), and population count. Rank sits flush LEFT next to
          // the city name on the same line, count is pushed to the
          // right end. The bar and meta below align with the city name
          // because the rank's fixed width keeps the column aligned.
          header.style.display = "flex";
          header.style.alignItems = "baseline";
          header.style.gap = "0.6rem";

          const rankCell = document.createElement("span");
          rankCell.className = "heb-landing__cities-rank";
          rankCell.textContent = String(rank).padStart(2, "0");
          rankCell.style.flex = "0 0 auto";
          rankCell.style.minWidth = "1.6rem";

          const name = document.createElement("span");
          name.className = "heb-landing__cities-name";
          name.textContent = city.name;
          name.style.flex = "1 1 auto";
          name.style.minWidth = "0";

          const count = document.createElement("span");
          count.className = "heb-landing__cities-count";
          count.dataset.cityCount = "true";
          count.textContent = "0";
          count.style.flex = "0 0 auto";

          header.append(rankCell, name, count);

          const barTrack = document.createElement("div");
          barTrack.className = "heb-landing__cities-bar-track";

          const bar = document.createElement("div");
          bar.className = "heb-landing__cities-bar";
          bar.dataset.cityBar = "true";
          bar.style.width = "0%";

          barTrack.appendChild(bar);

          const meta = document.createElement("span");
          meta.className = "heb-landing__cities-meta";
          meta.textContent = `${city.storeCount} H-E-B ${city.storeCount === 1 ? "location" : "locations"}`;

          body.append(header, barTrack, meta);

          item.append(body);
          list.appendChild(item);
        });

        const animateCounters = () => {
          const items = list.querySelectorAll<HTMLElement>(
            ".heb-landing__cities-item",
          );
          items.forEach((item, index) => {
            const target = Number(item.dataset.population ?? "0");
            const max = Number(item.dataset.maxPopulation ?? "1");
            const countEl =
              item.querySelector<HTMLElement>("[data-city-count]");
            const barEl = item.querySelector<HTMLElement>("[data-city-bar]");
            if (!countEl || !barEl) return;
            // Reset before animating in case the modal was opened
            // previously and the counter is showing the final value.
            countEl.textContent = "0";
            barEl.style.width = "0%";

            if (reduceMotion) {
              countEl.textContent = target.toLocaleString();
              barEl.style.width = `${(target / max) * 100}%`;
              return;
            }

            // Stagger so the numbers don't all spin at once — they
            // count up one row at a time, ~70ms apart. Top city
            // ticks up first, smaller cities follow.
            const proxy = { value: 0 };
            animate(proxy, {
              value: target,
              duration: 1400,
              delay: index * 70,
              ease: "outExpo",
              onUpdate: () => {
                countEl.textContent = Math.round(proxy.value).toLocaleString();
              },
              onComplete: () => {
                countEl.textContent = target.toLocaleString();
              },
            });
            animate(barEl, {
              width: [`0%`, `${(target / max) * 100}%`],
              duration: 1400,
              delay: index * 70,
              ease: "outExpo",
            });
          });
        };

        const open = (event?: Event) => {
          event?.preventDefault();
          modal.hidden = false;
          requestAnimationFrame(() => {
            modal.dataset.modalOpen = "true";
