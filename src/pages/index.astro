---
import HEBShinkansenLanding from "../components/HEBShinkansenLanding.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="HEB Shinkansen landing page for choosing Texas stations."
    />
    <title>HEB Shinkansen</title>
  </head>
  <body>
    <HEBShinkansenLanding />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    overflow-x: hidden;
  }
</style>
